// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

filegroup {
    name: "ivi-stats-publisher-proto-srcs",
    srcs: [
        "proto/*.proto",
    ],
}

filegroup {
    name: "ivi-stats-publisher-java-srcs",
    srcs: [
        "stats_publisher/*.java",
    ],
}

android_library {
    name: "telemetry_ivi_stats_publisher_lib",
    visibility: ["//system/software_defined_vehicle/telemetry/ivi_publishers/stats_publisher/tests:__subpackages__"],
    platform_apis: true,
    assets: ["stats_publisher/assets/*"],
    srcs: [
        ":ivi-stats-publisher-java-srcs",
        ":ivi-stats-publisher-proto-srcs",
    ],

    static_libs: [
        "google.sdv.telemetry.configurable_publisher-V2-java",
        "libprotobuf-java-lite",
        "androidx.annotation_annotation",
    ],

    manifest: "stats_publisher/LibraryAndroidManifest.xml",
}

android_app {
    name: "telemetry_ivi_stats_publisher",
    platform_apis: true,
    manifest: "stats_publisher/AndroidManifest.xml",
    static_libs: [
        "telemetry_ivi_stats_publisher_lib",
    ],
    optimize: {
        enabled: false,
    },
    system_ext_specific: true,
    privileged: true,
    asset_dirs: ["stats_publisher/assets"],
    certificate: "platform",
}

prebuilt_etc {
    name: "privapp-permissions-ivi_stats_publisher.xml",
    src: "stats_publisher/privapp-permissions-stats_publisher.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
