// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

rust_protobuf {
    name: "libstats_publisher_descriptor_proto_rust",
    crate_name: "stats_publisher_descriptor_proto_rust",
    protos: [":stats_publisher_descriptor"],
    source_stem: "stats_publisher_descriptor_proto_rust_source",
    product_available: true,
    vendor_available: true,
    system_ext_specific: true,
    visibility: ["//visibility:public"],
}

rust_defaults {
    name: "telemetry_stats_publisher_client_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "stats_publisher_client.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libbinder_rs",
        "libclap",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_utils",
        "libstats_publisher_descriptor_proto_rust",
        "libtokio",
        // keep-sorted end
    ],
}

rust_binary {
    name: "telemetry_stats_publisher_client",
    defaults: ["telemetry_stats_publisher_client_defaults"],
    product_specific: true,
}
