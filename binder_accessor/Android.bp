package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

cc_library {
    name: "libbinder_accessor",
    visibility: [
        // keep-sorted start
        "//system/software_defined_vehicle/samples/telemetry:__subpackages__",
        "//system/software_defined_vehicle/telemetry:__subpackages__",
        // keep-sorted end
    ],
    srcs: ["binder_access.cpp"],
    vendor_available: true,
    shared_libs: [
        "liblog",
        "libbinder_ndk",
    ],
    header_libs: ["jni_headers"],
    stl: "c++_shared",
}

java_library {
    name: "telemetry_binder_accessor",
    visibility: [
        // keep-sorted start
        "//system/software_defined_vehicle/samples/telemetry:__subpackages__",
        "//system/software_defined_vehicle/telemetry:__subpackages__",
        // keep-sorted end
    ],
    srcs: [
        "BinderServiceAccessor.java",
    ],
    sdk_version: "system_current",
}
