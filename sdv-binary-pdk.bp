// Copyright 2024 Google LLC

// build target to archive sample code to be shared with OEM's partners
// with access only to the binary PDK.
genrule {
    name: "telemetry_samples-dist",
    defaults: ["sdv@binary_pdk_dist"],
    srcs: [
        "samples/**/*",
    ],
    out: ["telemetry_samples.zip"],
}
