// Copyright 2023 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

// See https://source.android.com/devices/architecture/aidl/stable-aidl#module-naming-rules
// to learn how to use it.
aidl_interface {
    name: "google.sdv.telemetry",
    srcs: [
        "google/sdv/telemetry/*.aidl",
    ],
    vendor_available: true,
    owner: "google",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
}

aidl_interface {
    name: "google.sdv.telemetry.configurable_publisher",
    srcs: [
        "google/sdv/telemetry/configurable_publisher/*.aidl",
    ],
    vendor_available: true,
    owner: "google",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
}
