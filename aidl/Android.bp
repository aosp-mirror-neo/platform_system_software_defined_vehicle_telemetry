// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

// See https://source.android.com/devices/architecture/aidl/stable-aidl#module-naming-rules
// to learn how to use it.
aidl_interface {
    name: "android.sdv.telemetry",
    srcs: [
        "android/sdv/telemetry/*.aidl",
    ],
    vendor_available: true,
    system_ext_specific: true,
    stability: "vintf",
    owner: "google",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
        cpp: {
            enabled: true,
        },
    },
}

aidl_interface {
    name: "android.sdv.telemetry.configurable_publisher",
    srcs: [
        "android/sdv/telemetry/configurable_publisher/*.aidl",
    ],
    vendor_available: true,
    system_ext_specific: true,
    stability: "vintf",
    owner: "google",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
        cpp: {
            enabled: true,
        },
    },
}
