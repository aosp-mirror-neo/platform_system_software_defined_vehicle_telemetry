// Copyright 2024 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

// See https://source.android.com/devices/architecture/aidl/stable-aidl#module-naming-rules
// to learn how to use it.
aidl_interface {
    name: "google.sdv.telemetry",
    srcs: [
        "google/sdv/telemetry/**/*.aidl",
    ],
    product_available: true,
    vendor_available: true,
    stability: "vintf",
    owner: "google",
    backend: {
        java: {
            enabled: true,
        },
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}

vintf_fragment {
    name: "google.sdv.telemetry-service.xml",
    src: "google.sdv.telemetry-service.xml",
    vendor: true,
}
