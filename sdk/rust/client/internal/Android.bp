cc_defaults {
    name: "libsdv_telemetry_sdk_client_internal_cc_defaults",
    defaults: [
        "sdv_telemetry@cc_defaults",
    ],
    shared_libs: [
        // keep-sorted start
        "libbase",
        "libbinder_ndk",
        "libprotobuf-cpp-full",
        "libutils",
        // keep-sorted end
    ],
    cflags: [
        // Make sure that the log tag is 23 characters or less, otherwise it
        // will be truncated!
        "-DLOG_TAG=\"TelemetryClientLibC\"",
    ],
}

cc_library {
    name: "libsdv_telemetry_sdk_client_internal_cc",
    defaults: [
        "libsdv_telemetry_sdk_client_internal_cc_defaults",
    ],
    srcs: [
        // keep-sorted start
        "src/api_status_listener_impl.cpp",
        "src/config_list_listener_impl.cpp",
        "src/lib.cpp",
        "src/misc_status_listener_impl.cpp",
        "src/ready_reports_info_listener_impl.cpp",
        "src/report_listener_impl.cpp",
        "src/report_ready_listener_impl.cpp",
        "src/telemetry_service_client.cpp",
        // keep-sorted end
    ],
    local_include_dirs: [
        "include",
    ],
    export_include_dirs: [
        "export",
    ],
    shared_libs: [
        // keep-sorted start
        "google.sdv.telemetry-V1-ndk",
        "libsdv_telemetry_proto_cpp",
        // keep-sorted end
    ],
    product_available: true,
    vendor_available: true,
}

rust_bindgen {
    name: "libsdv_telemetry_sdk_client_internal_rust_bindgen",
    visibility: ["//system/software_defined_vehicle/telemetry/sdk/rust/client"],
    crate_name: "sdv_telemetry_sdk_client_internal",
    wrapper_src: "export/lib.h",
    source_stem: "bindings",
    shared_libs: [
        // keep-sorted start
        "libsdv_telemetry_sdk_client_internal_cc",
        // keep-sorted end
    ],
    product_available: true,
    vendor_available: true,
}

rust_test {
    name: "sdv_mt_telemetry_unit_sdk_client_internal_rust_bindgen_test",
    defaults: ["sdv_telemetry@rust_defaults"],
    crate_name: "sdv_telemetry_sdk_client_internal_tests",
    srcs: [
        ":libsdv_telemetry_sdk_client_internal_rust_bindgen",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,

    // Disable all lints because the generated code is not guaranteed to be
    // lint-free.
    clippy_lints: "none",
    lints: "none",
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}

rust_bindgen {
    name: "libsdv_telemetry_sdk_client_internal_status_codes_rust_bindgen",
    visibility: ["//system/software_defined_vehicle/telemetry/sdk/rust/client"],
    crate_name: "sdv_telemetry_sdk_client_internal_status_codes",
    wrapper_src: "export/status_codes.hpp",
    source_stem: "bindings",
    bindgen_flags: [
        "--default-enum-style=newtype",
    ],
    product_available: true,
    vendor_available: true,
}

rust_test {
    name: "sdv_mt_telemetry_unit_sdk_client_internal_status_codes_rust_bindgen_test",
    defaults: ["sdv_telemetry@rust_defaults"],
    crate_name: "sdv_telemetry_sdk_client_internal_status_codes_tests",
    srcs: [
        ":libsdv_telemetry_sdk_client_internal_status_codes_rust_bindgen",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,

    // Disable all lints because the generated code is not guaranteed to be
    // lint-free.
    clippy_lints: "none",
    lints: "none",
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
