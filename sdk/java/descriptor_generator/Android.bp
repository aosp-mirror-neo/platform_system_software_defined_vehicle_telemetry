package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
    default_visibility: ["//visibility:private"],
}

// **WARNING**: This part of the SDK is currently considered experimental. We
// might make **breaking changes** in the future. We are releasing it early to
// gather feedback. Please report any bugs and suggestions to us.
java_binary_host {
    name: "sdv_telemetry_sdk_descriptor_generator_java",
    visibility: ["//visibility:public"],
    srcs: ["src/com/android/sdv/telemetry/sdk/descriptor_generator/DescriptorGenerator.java"],
    main_class: "com.android.sdv.telemetry.sdk.descriptor_generator.DescriptorGenerator",
    required: ["aprotoc"],
    static_libs: [
        // keep-sorted start
        "javapoet",
        "jcommander",
        "libprotobuf-java-full",
        // keep-sorted end
    ],
}
