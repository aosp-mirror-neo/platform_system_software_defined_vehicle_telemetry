package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
    default_visibility: ["//visibility:private"],
}

java_defaults {
    name: "libsdv_telemetry_sdk_configurable_publisher_registry_java_defaults",
    sdk_version: "system_current",
    vendor: true,
}

java_library {
    name: "libsdv_telemetry_sdk_configurable_publisher_registry_java",
    visibility: ["//visibility:public"],
    defaults: ["libsdv_telemetry_sdk_configurable_publisher_registry_java_defaults"],
    srcs: ["src/**/*.java"],
    static_libs: [
        // keep-sorted start
        "androidx.annotation_annotation",
        "androidx.core_core",
        "google.sdv.telemetry.configurable_publisher-V2-java",
        "libprotobuf-java-lite",
        "libsdv_telemetry_sdk_binder_accessor_java",
        // keep-sorted end
    ],
}

android_test {
    name: "sdv_ivi_telemetry_unit_sdk_configurable_publisher_registry_java_test",
    defaults: ["libsdv_telemetry_sdk_configurable_publisher_registry_java_defaults"],
    srcs: [
        // keep-sorted start
        ":libprotobuf-internal-protos",
        "tests/src/**/*.java",
        // keep-sorted end
    ],
    manifest: "tests/AndroidManifest.xml",
    test_config: "tests/AndroidTest.xml",
    proto: {
        type: "lite",
        include_dirs: ["external/protobuf/src"],
    },
    static_libs: [
        // keep-sorted start
        "androidx.core_core",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "libprotobuf-java-lite",
        "libsdv_telemetry_sdk_configurable_publisher_registry_java",
        "mockito-core",
        "mockito-target-inline",
        "truth",
        // keep-sorted end
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    jni_libs: [
        // keep-sorted start
        // Required by the `mockito-target-inline` dependency.
        "libdexmakerjvmtiagent",
        "libsdv_telemetry_sdk_binder_accessor_java_jni",
        // keep-sorted end
    ],
    use_embedded_native_libs: true,
    jni_uses_platform_apis: true,
}
