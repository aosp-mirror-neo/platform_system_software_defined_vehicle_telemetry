// Copyright 2023 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

cc_defaults {
    name: "sdv_telemetry@cc_defaults",
    defaults: [
        "sdv@cc_defaults",
        "sdv_tracing@cc_defaults",
    ],
    cflags: [
        "-Wno-unused-private-field",
    ],
}

rust_defaults {
    name: "sdv_telemetry@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    flags: [
        // By enforcing this lint, we make it a lot more obvious when a conversion
        // is potentially lossy, because lossless conversions are no longer
        // allowed to be written as `a as XX`.
        "-D clippy::cast_lossless",
        // By enabling this lint, we make it easier to understand whether
        // something being cloned is actually just cloning a pointer, or cloning
        // the actual object.
        "-D clippy::clone_on_ref_ptr",
        // We prefer `if let ... {} else {}` over a `match` with two arms (note:
        // this lint will not apply if the `match` statement has very simple
        // arms).
        "-D clippy::single_match_else",
        // Similarly, we prefer `if ... {} else {}` over a `match` for bools.
        "-D clippy::match_bool",
    ],
}

rust_defaults {
    name: "libsdv_telemetry_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "src/telemetry_service.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "liblog_rust",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_time_wrapper",
        "libsdv_telemetry_utils",
        "libthiserror",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
}

rust_library {
    name: "libsdv_telemetry",
    defaults: ["libsdv_telemetry_defaults"],
    crate_name: "sdv_telemetry",
    vendor_available: true,
}

rust_defaults {
    name: "libsdv_telemetry_configurable_publisher_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "src/configurable_publisher_registry_service.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "liblog_rust",
        "libprotobuf",
        "libsdv_telemetry",
        "libsdv_telemetry_utils",
        "libthiserror",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        "libclap_derive",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_configurable_publisher",
    defaults: ["libsdv_telemetry_configurable_publisher_defaults"],
    crate_name: "sdv_telemetry_configurable_publisher",
}

rust_defaults {
    name: "libsdv_telemetry_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "src/utils/lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "liblazy_static",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libtokio",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_utils",
    defaults: ["libsdv_telemetry_utils_defaults"],
    crate_name: "sdv_telemetry_utils",
}

rust_defaults {
    name: "telemetry_dt_wrapper_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["src/data_tunnel_wrapper/lib.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libcxx",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_dt_rust",
        "libsdv_telemetry",
        "libsdv_telemetry_metadata_proto_rust",
        "libsdv_telemetry_utils",
        "libthiserror",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_dt_wrapper",
    crate_name: "sdv_telemetry_dt_wrapper",
    defaults: ["telemetry_dt_wrapper_defaults"],
}

rust_defaults {
    name: "telemetry_dt_wrapper_tests_defaults",
    defaults: ["telemetry_dt_wrapper_defaults"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
}

rust_test {
    name: "libsdv_telemetry_dt_wrapper_unit_tests",
    defaults: ["telemetry_dt_wrapper_tests_defaults"],
    cfgs: ["unit_tests"],
    test_options: {
        unit_test: true,
    },
    proc_macros: [
        // keep-sorted start
        "libsdv_telemetry_test_utils_macros",
        // keep-sorted end
    ],
}

rust_test {
    name: "libsdv_telemetry_dt_wrapper_integration_tests",
    defaults: ["telemetry_dt_wrapper_tests_defaults"],
    cfgs: ["integration_tests"],
    rustlibs: [
        // keep-sorted start
        "librand",
        "libsdv_telemetry_test_proto",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libsdv_telemetry_test_utils_macros",
        // keep-sorted end
    ],
    // Requires root so the test can perform Binder calls to the data tunnel
    // agent.
    require_root: true,
}

rust_defaults {
    name: "sdv_telemetry_service_agent_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],

    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry-V1-rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "liblog_rust",
        "librustutils",
        "libsdv_log_rust",
        "libsdv_telemetry",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    vendor: true,
}

rust_binary {
    name: "sdv_telemetry_service_agent",
    defaults: ["sdv_telemetry_service_agent_defaults"],
    srcs: [
        "src/main.rs",
    ],

    rustlibs: [
        // keep-sorted start
        "libsdv_telemetry_dt_wrapper",
        // keep-sorted end

        // TODO (b/343460855): Remove configurable publisher from SDV after RPC support
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libsdv_telemetry_configurable_publisher",
        // End of configurable publisher deps
    ],
}

rust_binary {
    name: "sdv_ivi_telemetry_service_agent",
    defaults: ["sdv_telemetry_service_agent_defaults"],
    srcs: [
        "src/main_ivi.rs",
    ],

    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libsdv_telemetry_configurable_publisher",
        // keep-sorted end
    ],
}

rust_test {
    name: "libsdv_telemetry_unit_tests",
    defaults: ["libsdv_telemetry_defaults"],
    rustlibs: [
        // keep-sorted start
        "liblazy_static",
        "librand",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_test_proto",
        "libsdv_telemetry_utils",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        "libpaste",
        "libsdv_telemetry_test_utils_macros",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
    vendor: true,
}

rust_test {
    name: "libsdv_telemetry_configurable_publisher_unit_tests",
    defaults: ["libsdv_telemetry_configurable_publisher_defaults"],
    rustlibs: [
        // keep-sorted start
        "libsample_publisher_proto",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libsdv_telemetry_test_utils_macros",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

rust_test {
    name: "libsdv_telemetry_utils_unit_tests",
    defaults: ["libsdv_telemetry_utils_defaults"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

rust_test {
    name: "sdv_telemetry_integration_tests",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "tests/integration_tests.rs",
    ],
    // Use a custom test config template as per
    // https://source.android.com/docs/core/tests/vts/setup11, because we need
    // to ensure that the integration tests are run serially, not in parallel,
    // by adding the `--test-threads=1` flag to the test execution.
    test_config_template: "tests/integration_tests_config_template.config",
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libbinder_rs",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_sample_utils",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libsdv_telemetry_test_utils_macros",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    data: [
        // keep-sorted start
        "**/*.textproto",
        // keep-sorted end
    ],
    auto_gen_config: true,
    // Requires root so the test can perform Binder calls.
    require_root: true,
    vendor: true,
}

build = [
    "sdv-binary-pdk.bp",
]
