// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

cc_defaults {
    name: "sdv_telemetry@cc_defaults",
    defaults: [
        "sdv@cc_defaults",
        "sdv_tracing@cc_defaults",
    ],
    cflags: [
        "-Wno-unused-private-field",
    ],
}

cc_library {
    name: "libsdvtelemetry_proto_cpp",
    defaults: [
        "sdv_telemetry@cc_defaults",
    ],
    srcs: [":sdvtelemetryservice-proto-srcs"],
    proto: {
        export_proto_headers: true,
        include_dirs: ["external/protobuf/src"],
        type: "full",
    },
    shared_libs: ["libprotobuf-cpp-full"],
    vendor_available: true,
    system_ext_specific: true,
}

rust_defaults {
    name: "sdv_telemetry@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    flags: [
        // By enforcing this lint, we make it a lot more obvious when a conversion
        // is potentially lossy, because lossless conversions are no longer
        // allowed to be written as `a as XX`.
        "-D clippy::cast_lossless",
        // By enabling this lint, we make it easier to understand whether
        // something being cloned is actually just cloning a pointer, or cloning
        // the actual object.
        "-D clippy::clone_on_ref_ptr",
    ],
}

rust_protobuf {
    name: "libsdvtelemetry_proto_rust",
    crate_name: "sdvtelemetry_proto_rust",
    protos: [":sdvtelemetryservice-proto-srcs"],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdvtelemetry_proto_rust_source",
    vendor_available: true,
    system_ext_specific: true,
    visibility: ["//visibility:public"],
}

rust_protobuf {
    name: "libsdvtelemetry_metadata_proto_rust",
    crate_name: "sdvtelemetry_metadata_proto_rust",
    protos: [":sdvtelemetryservice-metadata-proto-srcs"],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdvtelemetry_metadata_proto_rust_source",
    vendor_available: true,
    system_ext_specific: true,
}

rust_defaults {
    name: "libsdv_telemetry_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "src/telemetry_service.rs",
    ],
    rustlibs: [
        "google.sdv.telemetry-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "liblog_rust",
        "libprotobuf",
        "libthiserror",
        "libtokio",
        "libsdvtelemetry_proto_rust",
        "libsdv_telemetry_utils",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_library {
    name: "libsdv_telemetry",
    defaults: ["libsdv_telemetry_defaults"],
    crate_name: "sdv_telemetry",
    vendor_available: true,
    system_ext_specific: true,
}

rust_defaults {
    name: "libsdv_telemetry_configurable_publisher_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "src/configurable_publisher_registry_service.rs",
    ],
    rustlibs: [
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "liblog_rust",
        "libsdv_telemetry",
        "libsdv_telemetry_utils",
        "libprotobuf",
        "libthiserror",
        "libtokio",
    ],
    proc_macros: [
        "libasync_trait",
        "libclap_derive",
    ],
}

rust_library {
    name: "libsdv_telemetry_configurable_publisher",
    defaults: ["libsdv_telemetry_configurable_publisher_defaults"],
    crate_name: "sdv_telemetry_configurable_publisher",
    vendor_available: true,
    system_ext_specific: true,
}

rust_defaults {
    name: "libsdv_telemetry_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "src/utils/lib.rs",
    ],
    rustlibs: [
        "liblazy_static",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libtokio",
    ],
}

rust_library {
    name: "libsdv_telemetry_utils",
    defaults: ["libsdv_telemetry_utils_defaults"],
    crate_name: "sdv_telemetry_utils",
    vendor_available: true,
    system_ext_specific: true,
}

rust_defaults {
    name: "telemetry_dt_wrapper_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["src/data_tunnel_wrapper/lib.rs"],
    rustlibs: [
        "libanyhow",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_dt_rust",
        "libsdv_telemetry",
        "libsdvtelemetry_metadata_proto_rust",
        "libsdv_telemetry_utils",
        "libthiserror",
        "libtokio",
        "libcxx",
        "liblibc",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_library {
    name: "libsdv_telemetry_dt_wrapper",
    crate_name: "sdv_telemetry_dt_wrapper",
    defaults: ["telemetry_dt_wrapper_defaults"],
    vendor_available: true,
    system_ext_specific: true,
}

rust_defaults {
    name: "telemetry_dt_wrapper_tests_defaults",
    defaults: ["telemetry_dt_wrapper_defaults"],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    target: {
        host: {
            data_libs: [
                "libcutils",
                "libbase",
                "libc++",
                "libutils",
                "liblog",
                "libbinder_ndk",
                "libbinder",
            ],
        },
    },
    auto_gen_config: true,
}

rust_test {
    name: "libsdv_telemetry_dt_wrapper_unit_tests",
    defaults: ["telemetry_dt_wrapper_tests_defaults"],
    cfgs: ["unit_tests"],
    test_options: {
        unit_test: true,
    },
}

rust_test {
    name: "libsdv_telemetry_dt_wrapper_integration_tests",
    defaults: ["telemetry_dt_wrapper_tests_defaults"],
    cfgs: ["integration_tests"],
    rustlibs: [
        "librand",
        "libsdv_telemetry_test_proto",
    ],
    // Requires root so the test can perform Binder calls to the data tunnel
    // agent.
    require_root: true,
}

rust_defaults {
    name: "sdv_telemetry_service_agent_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    vendor_available: true,
    system_ext_specific: true,
    vintf_fragments: [
        "google.sdv.telemetry-service.xml",
    ],
    rustlibs: [
        "google.sdv.telemetry-V1-rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "liblog_rust",
        "librustutils",
        "libsdv_log_rust",
        "libsdv_telemetry",
        "libsdv_telemetry_utils",
        "libsdvtelemetry_proto_rust",
        "libtokio",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_binary {
    name: "sdv_telemetry_service_agent",
    defaults: ["sdv_telemetry_service_agent_defaults"],
    srcs: [
        "src/main.rs",
    ],
    vintf_fragments: [
        // TODO (b/343460855): Remove configurable publisher from SDV after RPC support
        "google.sdv.telemetry.configurable_publisher-service.xml",
        // End of configurable publisher fragments
    ],
    rustlibs: [
        "libsdv_telemetry_dt_wrapper",
        // TODO (b/343460855): Remove configurable publisher from SDV after RPC support
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libsdv_telemetry_configurable_publisher",
        // End of configurable publisher deps
    ],
    vendor_available: true,
    system_ext_specific: true,
}

rust_binary {
    name: "sdv_ivi_telemetry_service_agent",
    defaults: ["sdv_telemetry_service_agent_defaults"],
    srcs: [
        "src/main_ivi.rs",
    ],
    vintf_fragments: [
        "google.sdv.telemetry.configurable_publisher-service.xml",
    ],
    rustlibs: [
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libsdv_telemetry_configurable_publisher",
    ],
    system_ext_specific: true,
    vendor_available: true,
}

rust_test {
    name: "libsdv_telemetry_unit_tests",
    defaults: ["libsdv_telemetry_defaults"],
    rustlibs: [
        "liblazy_static",
        "librand",
        "libsdv_telemetry_test_proto",
        "libsdvtelemetry_proto_rust",
        "libsdv_telemetry_utils",
    ],
    proc_macros: [
        "libasync_trait",
        "libpaste",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    target: {
        host: {
            data_libs: [
                "libcutils",
                "libbase",
                "libc++",
                "libutils",
                "liblog",
                "libbinder_ndk",
                "libbinder",
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

rust_test {
    name: "libsdv_telemetry_configurable_publisher_unit_tests",
    defaults: ["libsdv_telemetry_configurable_publisher_defaults"],
    rustlibs: [
        "libsample_publisher_proto",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    target: {
        host: {
            data_libs: [
                "libcutils",
                "libbase",
                "libc++",
                "libutils",
                "liblog",
                "libbinder_ndk",
                "libbinder",
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

rust_test {
    name: "libsdv_telemetry_utils_unit_tests",
    defaults: ["libsdv_telemetry_utils_defaults"],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    target: {
        host: {
            data_libs: [
                "libcutils",
                "libbase",
                "libc++",
                "libutils",
                "liblog",
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

rust_test {
    name: "sdv_telemetry_integration_tests",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "tests/integration_tests.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libfutures",
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "libsdv_telemetry_bindgen",
        "libsdv_telemetry_sample_utils",
        "libsdv_telemetry_status_codes_bindgen",
        "libsdv_telemetry_utils",
        "libtokio",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    data: [
        "**/*.textproto",
    ],
    auto_gen_config: true,
    // Requires root so the test can perform Binder calls.
    require_root: true,
}

rust_bindgen {
    name: "libsdv_telemetry_bindgen",
    crate_name: "sdv_telemetry_bindgen",
    wrapper_src: "clientlib/export/lib.h",
    source_stem: "bindings",
    shared_libs: [
        "libtelemetry_c",
    ],
    vendor_available: true,
    system_ext_specific: true,
}

rust_test {
    name: "libsdv_telemetry_bindgen_tests",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        ":libsdv_telemetry_bindgen",
    ],
    crate_name: "sdv_telemetry_bindgen_tests",
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,

    // Disable all lints because the generated code is not guaranteed to be
    // lint-free.
    clippy_lints: "none",
    lints: "none",
}

rust_bindgen {
    name: "libsdv_telemetry_status_codes_bindgen",
    crate_name: "sdv_telemetry_status_codes_bindgen",
    wrapper_src: "clientlib/export/status_codes.h",
    cpp_std: "gnu++17",
    source_stem: "bindings",
    vendor_available: true,
    system_ext_specific: true,
}

rust_test {
    name: "libsdv_telemetry_status_codes_bindgen_tests",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        ":libsdv_telemetry_status_codes_bindgen",
    ],
    crate_name: "sdv_telemetry_status_codes_bindgen_tests",
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,

    // Disable all lints because the generated code is not guaranteed to be
    // lint-free.
    clippy_lints: "none",
    lints: "none",
}

build = [
    "sdv-binary-pdk.bp",
]
