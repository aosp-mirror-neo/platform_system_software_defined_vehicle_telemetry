// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

cc_library {
    name: "libsdvtelemetry_proto_cpp",
    host_supported: true,
    srcs: [":sdvtelemetryservice-proto-srcs"],
    proto: {
        export_proto_headers: true,
        include_dirs: ["external/protobuf/src"],
        type: "full",
    },
    shared_libs: ["libprotobuf-cpp-full"],
}

rust_defaults {
    name: "telemetry@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    rustlibs: [
        "liblog_rust",
        "liblogger",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "librand",
        "libtokio",
        "libthiserror",
        "android.sdv.telemetry-rust",
        "libsdv_log_rust",
    ],
}

rust_protobuf {
    name: "libsdvtelemetry_proto_rust",
    host_supported: true,
    crate_name: "sdvtelemetry_proto_rust",
    protos: [":sdvtelemetryservice-proto-srcs"],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdvtelemetry_proto_rust_source",
    use_protobuf3: true,
}

rust_library {
    name: "libsdv_telemetry",
    crate_name: "sdv_telemetry",
    defaults: ["telemetry@rust_defaults"],
    host_supported: true,
    srcs: [
        "src/telemetry_service.rs",
    ],
    rustlibs: [
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
    ],
    proc_macros: [
        "libasync_trait",
        "libclap_derive",
    ],
}

rust_binary {
    name: "sdv_telemetry_service",
    defaults: ["telemetry@rust_defaults"],
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libsdv_telemetry",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "librustutils",
    ],
}

rust_test_host {
    name: "libsdv_telemetry_unit_tests",
    defaults: ["telemetry@rust_defaults"],
    srcs: [
        "src/telemetry_service.rs",
    ],
    rustlibs: [
        "libfutures",
        "liblazy_static",
        "libprotobuf",
        "libsdv_telem_test_proto",
        "libsdvtelemetry_proto_rust",
    ],
    proc_macros: [
        "libasync_trait",
        "libclap_derive",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    target: {
        host: {
            data_libs: [
                "libcutils",
                "libbase",
                "libc++",
                "libutils",
                "liblog",
                "libbinder_ndk",
                "libbinder",
            ],
        },
    },
    auto_gen_config: true,
}

rust_bindgen {
    name: "libsdv_telemetry_bindgen",
    crate_name: "sdv_telemetry_bindgen",
    wrapper_src: "clientlib/export/lib.h",
    source_stem: "bindings",
    shared_libs: [
        "libtelemetry_c",
    ],

}

rust_bindgen {
    name: "libstatus_codes_bindgen",
    crate_name: "status_codes_bindgen",
    wrapper_src: "clientlib/export/status_codes.h",
    cpp_std: "gnu++17",
    source_stem: "bindings",

}
