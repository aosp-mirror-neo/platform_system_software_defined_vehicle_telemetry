// Copyright 2023 Google LLC

filegroup {
    name: "sdv_telemetry_proto_srcs",
    srcs: ["metrics_configuration/*.proto"],
}

filegroup {
    name: "sdv_telemetry_metadata_proto_srcs",
    srcs: ["metadata_protos/*.proto"],
}

filegroup {
    name: "sdv_telemetry_simulator_proto_srcs",
    srcs: ["simulator/*.proto"],
}

cc_library {
    name: "libsdv_telemetry_proto_cpp",
    defaults: [
        "sdv_telemetry@cc_defaults",
    ],
    srcs: [":sdv_telemetry_proto_srcs"],
    proto: {
        export_proto_headers: true,
        include_dirs: ["external/protobuf/src"],
        type: "full",
    },
    shared_libs: ["libprotobuf-cpp-full"],
    product_available: true,
    vendor_available: true,
    system_ext_specific: true,
}

python_library_host {
    name: "libsdv_telemetry_proto_python",
    version: {
        py3: {
            enabled: true,
        },
    },
    srcs: [":sdv_telemetry_proto_srcs"],
    proto: {
        canonical_path_from_root: true,
        include_dirs: [
            "external/protobuf/src",
            ".",
        ],
    },
}

rust_protobuf {
    name: "libsdv_telemetry_proto_rust",
    crate_name: "sdv_telemetry_proto_rust",
    protos: [":sdv_telemetry_proto_srcs"],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdv_telemetry_proto_rust_source",
    product_available: true,
    vendor_available: true,
    system_ext_specific: true,
    visibility: ["//visibility:public"],
}

rust_protobuf {
    name: "libsdv_telemetry_metadata_proto_rust",
    crate_name: "sdv_telemetry_metadata_proto_rust",
    protos: [":sdv_telemetry_metadata_proto_srcs"],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdv_telemetry_metadata_proto_rust_source",
    vendor_available: true,
    system_ext_specific: true,
}

rust_protobuf {
    name: "libsdv_telemetry_proto_simulation_publisher",
    crate_name: "sdv_telemetry_proto_simulation_publisher",
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    protos: [":sdv_telemetry_simulator_proto_srcs"],
    source_stem: "sdv_telemetry_proto_simulation_publisher_source",
    vendor_available: true,
}

python_library_host {
    name: "libsdv_telemetry_proto_simulation_publisher_python",
    version: {
        py3: {
            enabled: true,
        },
    },
    srcs: [":sdv_telemetry_simulator_proto_srcs"],
    proto: {
        canonical_path_from_root: true,
        include_dirs: [
            "external/protobuf/src",
            ".",
        ],
    },
}
