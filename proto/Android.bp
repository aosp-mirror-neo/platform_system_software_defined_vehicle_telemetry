// Copyright 2023 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

filegroup {
    name: "sdv_telemetry_proto_srcs",
    visibility: ["//visibility:public"],
    srcs: ["metrics_configuration/*.proto"],
}

cc_library {
    name: "libsdv_telemetry_proto_cpp",
    visibility: ["//system/software_defined_vehicle/telemetry/clientlib:__subpackages__"],
    defaults: [
        "sdv_telemetry@cc_defaults",
    ],
    srcs: [":sdv_telemetry_proto_srcs"],
    proto: {
        export_proto_headers: true,
        include_dirs: ["external/protobuf/src"],
        type: "full",
    },
    shared_libs: ["libprotobuf-cpp-full"],
    product_available: true,
    vendor_available: true,
    system_ext_specific: true,
}

python_library_host {
    name: "libsdv_telemetry_proto_python",
    visibility: ["//visibility:public"],
    srcs: [":sdv_telemetry_proto_srcs"],
    proto: {
        canonical_path_from_root: true,
        include_dirs: [
            "external/protobuf/src",
            ".",
        ],
    },
}

rust_protobuf {
    name: "libsdv_telemetry_proto_rust",
    visibility: ["//visibility:public"],
    crate_name: "sdv_telemetry_proto_rust",
    protos: [":sdv_telemetry_proto_srcs"],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdv_telemetry_proto_rust_source",
    product_available: true,
    vendor_available: true,
    system_ext_specific: true,
}

java_library {
    name: "libsdv_telemetry_proto_java",
    visibility: ["//visibility:public"],
    sdk_version: "system_current",
    srcs: [
        ":sdv_telemetry_proto_srcs",
        ":libprotobuf-internal-protos",
        ":libprotobuf-internal-any-proto",
    ],
    proto: {
        type: "lite",
        include_dirs: ["external/protobuf/src"],
    },
    static_libs: [
        "libprotobuf-java-lite",
    ],
}
