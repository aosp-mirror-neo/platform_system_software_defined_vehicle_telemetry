// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "telemetry_rust_client",
    srcs: [
        "rust/telemetry_rust_client.rs",
    ],
    rustlibs: [
        "liblog_rust",
        "liblogger",
        "libbinder_rs",
        "android.sdv.telemetry-rust",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
    ],
}

rust_binary {
    name: "telemetry_rust_c_client",
    srcs: [
        "rust/telemetry_rust_c_client.rs",
    ],
    rustlibs: [
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
    ],
    shared_libs: [
        "libtelemetry_c",
    ],
}

cc_binary {
    name: "telemetry_cpp_client",
    srcs: ["cpp/telemetry_cpp_client.cpp"],
    defaults: [
        "telemetry_defaults",
    ],
    shared_libs: [
        "libsdvtelemetry_proto_cpp",
        "libtelemetry_c",
        "liblog",
    ],
}
