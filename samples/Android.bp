// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

cc_binary {
    name: "telemetry_cpp_client",
    srcs: [
        "cpp/telemetry_cpp_client.cpp",
        "cpp/metrics_config_manager.cpp",
        "cpp/metrics_report_manager.cpp",
    ],
    local_include_dirs: [
        "cpp/include",
    ],
    defaults: [
        "telemetry_defaults",
    ],
    shared_libs: [
        "libsdvtelemetry_proto_cpp",
        "libtelemetry_c",
        "liblog",
    ],
}

rust_binary {
    name: "telemetry_rust_c_client",
    srcs: [
        "rust/telemetry_client/telemetry_rust_c_client.rs",
    ],
    rustlibs: [
        "libfutures",
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "libsdv_telemetry_bindgen",
        "libstatus_codes_bindgen",
        "libtokio",
    ],
}

rust_protobuf {
    name: "libconfigurable_publisher_proto",
    host_supported: true,
    crate_name: "configurable_publisher_proto",
    protos: [
        "rust/sample_publisher/sample_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
    use_protobuf3: true,
}

rust_binary {
    name: "telemetry_sample_publisher",
    srcs: [
        "rust/sample_publisher/main.rs",
    ],
    rustlibs: [
        "android.sdv.telemetry.configurable_publisher-rust",
        "libbinder_rs",
        "libconfigurable_publisher_proto",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libtokio",
    ],
}
