// Copyright 2023 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "telemetry_rust_c_client_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "rust/telemetry_client/telemetry_rust_c_client.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libbinder_rs",
        "libclap",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_sample_utils",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
}

rust_binary {
    name: "telemetry_rust_c_client",
    defaults: ["telemetry_rust_c_client_defaults"],
    vendor: true,
}

rust_protobuf {
    name: "libsample_publisher_proto",
    crate_name: "sample_publisher_proto",
    protos: [
        "rust/sample_publisher/sample_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
    vendor_available: true,
}

rust_defaults {
    name: "telemetry_sample_getter_publisher_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "rust/sample_getter_publisher/main.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libbinder_rs",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libsample_publisher_proto",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    vendor: true,
}

rust_binary {
    name: "telemetry_sample_getter_publisher",
    defaults: ["telemetry_sample_getter_publisher_defaults"],
}

rust_test {
    name: "telemetry_sample_getter_publisher_unit_tests",
    defaults: ["telemetry_sample_getter_publisher_defaults"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

rust_binary {
    name: "telemetry_sample_publisher",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "rust/sample_publisher/main.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libbinder_rs",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libparking_lot",
        "libprotobuf",
        "librand",
        "libsample_publisher_proto",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    vendor: true,
}

rust_binary {
    name: "dt_telemetry_sample_publisher",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["rust/data_tunnel_publisher/publish_sample.rs"],
    rustlibs: [
        // keep-sorted start
        "libcxx",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libsample_publisher_proto",
        "libsdv_dt_rust",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_telemetry_metadata_proto_rust",
        "libsdv_telemetry_utils",
        // keep-sorted end
    ],
    vendor: true,
}

rust_binary {
    name: "telemetry_sample_data_tunnel_publisher_speed",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["rust/data_tunnel_publisher_speed/speed_publisher.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libcxx",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libsdv_dt_rust",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_telemetry_metadata_proto_rust",
        "libsdv_telemetry_utils",
        "libspeed_publisher_proto",
        // keep-sorted end
    ],
    vendor: true,
}

rust_protobuf {
    name: "libspeed_publisher_proto",
    crate_name: "speed_publisher_proto",
    protos: [
        "rust/data_tunnel_publisher_speed/speed_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
