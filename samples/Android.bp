rust_defaults {
    name: "libsdv_telemetry_sample_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "rust/utils/lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        // keep-sorted end
    ],
    vendor: true,
}

rust_library {
    name: "libsdv_telemetry_sample_utils",
    defaults: ["libsdv_telemetry_sample_utils_defaults"],
    crate_name: "sdv_telemetry_sample_utils",
}

rust_test {
    name: "sdv_telemetry_sample_utils_unit_tests",
    defaults: ["libsdv_telemetry_sample_utils_defaults"],
    rustlibs: [
        // keep-sorted start
        "libsdv_telemetry_utils",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    data: [
        // keep-sorted start
        "sample_protos/metric_configJan10.textproto",
        // keep-sorted end
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}
