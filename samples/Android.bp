    name: "telemetry_sample_data_tunnel_publisher_tire_pressure",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["rust/data_tunnel_publisher_tire_pressure/tire_pressure_publisher.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libcxx",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libsdv_dt_rust",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_telemetry_metadata_proto_rust",
        "libsdv_telemetry_utils",
        "libtire_pressure_publisher_proto",
        // keep-sorted end
    ],
    vendor: true,
}

rust_protobuf {
    name: "libtire_pressure_publisher_proto",
    crate_name: "tire_pressure_publisher_proto",
    protos: [
        "rust/data_tunnel_publisher_tire_pressure/tire_pressure_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
