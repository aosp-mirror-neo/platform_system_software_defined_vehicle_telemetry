    vendor: true,
}

rust_binary {
    name: "telemetry_sample_publisher",
    defaults: ["telemetry_sample_publisher_defaults"],
}

rust_test {
    name: "telemetry_sample_publisher_unit_tests",
    defaults: ["telemetry_sample_publisher_defaults"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

