// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

cc_binary {
    name: "telemetry_cpp_client",
    srcs: [
        "cpp/telemetry_cpp_client.cpp",
        "cpp/metrics_config_manager.cpp",
        "cpp/metrics_report_manager.cpp",
    ],
    local_include_dirs: [
        "cpp/include",
    ],
    defaults: [
        "telemetry_defaults",
    ],
    shared_libs: [
        "libsdvtelemetry_proto_cpp",
        "libtelemetry_c",
        "liblog",
    ],
}

rust_binary {
    name: "telemetry_rust_c_client",
    srcs: [
        "rust/telemetry_client/telemetry_rust_c_client.rs",
    ],
    rustlibs: [
        "libfutures",
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "libsdv_telemetry_bindgen",
        "libstatus_codes_bindgen",
        "libtokio",
    ],
}

rust_protobuf {
    name: "libsample_publisher_proto",
    crate_name: "sample_publisher_proto",
    protos: [
        "rust/sample_publisher/sample_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
}

rust_binary {
    name: "telemetry_sample_publisher",
    srcs: [
        "rust/sample_publisher/main.rs",
    ],
    rustlibs: [
        "android.sdv.telemetry.configurable_publisher-rust",
        "libbinder_rs",
        "libsample_publisher_proto",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libtokio",
    ],
}

rust_binary {
    name: "dt_telemetry_sample_publisher",
    srcs: ["rust/data_tunnel_publisher/publish_sample.rs"],
    rustlibs: [
        "libsample_publisher_proto",
        "libsdvtelemetry_metadata_proto_rust",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_dt_rust",
        "libcxx",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
    ],
    system_ext_specific: true,
}
