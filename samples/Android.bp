// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "telemetry_rust_c_client",
    srcs: [
        "rust/telemetry_client/telemetry_rust_c_client.rs",
    ],
    rustlibs: [
        "libclap",
        "libfutures",
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_sample_utils",
        "libtokio",
    ],
    vendor: true,
}

// TODO(b/335224692): Remove IVI-specific target when Telemetry clients are allowed to be on Vendor partition
// in IVI and telemetry_rust_c_client works there.
rust_binary {
    name: "telemetry_ivi_rust_c_client",
    srcs: [
        "rust/telemetry_client/telemetry_rust_c_client.rs",
    ],
    rustlibs: [
        "libclap",
        "libfutures",
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_sample_utils",
        "libtokio",
    ],
}

rust_protobuf {
    name: "libsample_publisher_proto",
    crate_name: "sample_publisher_proto",
    protos: [
        "rust/sample_publisher/sample_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
    vendor_available: true,
    system_ext_specific: true,
}

rust_binary {
    name: "telemetry_sample_publisher",
    srcs: [
        "rust/sample_publisher/main.rs",
    ],
    rustlibs: [
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libbinder_rs",
        "libsample_publisher_proto",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libtokio",
    ],
    vendor: true,
}

rust_binary {
    name: "dt_telemetry_sample_publisher",
    srcs: ["rust/data_tunnel_publisher/publish_sample.rs"],
    rustlibs: [
        "libsample_publisher_proto",
        "libsdvtelemetry_metadata_proto_rust",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_dt_rust",
        "libcxx",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
    ],
    vendor: true,
}

rust_binary {
    name: "telemetry_sample_data_tunnel_publisher_speed",
    srcs: ["rust/data_tunnel_publisher_speed/speed_publisher.rs"],
    rustlibs: [
        "libspeed_publisher_proto",
        "libsdvtelemetry_metadata_proto_rust",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_dt_rust",
        "libcxx",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libanyhow",
    ],
    vendor: true,
}

rust_protobuf {
    name: "libspeed_publisher_proto",
    crate_name: "speed_publisher_proto",
    protos: [
        "rust/data_tunnel_publisher_speed/speed_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
    vendor_available: true,
    system_ext_specific: true,
}

rust_library {
    name: "libsdv_telemetry_sample_utils",
    crate_name: "sdv_telemetry_sample_utils",
    defaults: ["telemetry@rust_defaults"],
    srcs: [
        "rust/utils/lib.rs",
    ],
    rustlibs: [
        "libsdvtelemetry_proto_rust",
    ],
    vendor_available: true,
    system_ext_specific: true,
}

rust_test {
    name: "sdv_telemetry_sample_utils_unit_tests",
    defaults: ["telemetry@rust_defaults"],
    srcs: [
        "rust/utils/lib.rs",
    ],
    rustlibs: [
        "libsdv_telemetry_sample_utils",
        "libsdvtelemetry_proto_rust",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    data: [
        "sample_protos/metric_configJan10.textproto",
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}
