}

rust_binary {
    name: "telemetry_sample_data_tunnel_publisher_error_report",
    srcs: ["rust/data_tunnel_publisher_error_report/error_report_publisher.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libcxx",
        "liberror_report_publisher_proto",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libsdv_dt_rust",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_telemetry_metadata_proto_rust",
        "libsdv_telemetry_utils",
        // keep-sorted end
    ],
    vendor: true,
}

rust_protobuf {
    name: "liberror_report_publisher_proto",
    crate_name: "error_report_publisher_proto",
    protos: [
        "rust/data_tunnel_publisher_error_report/error_report_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
    vendor: true,
