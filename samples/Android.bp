// Copyright 2023 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "telemetry_rust_c_client_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "rust/telemetry_client/telemetry_rust_c_client.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libbinder_rs",
        "libclap",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_sample_utils",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
}

cc_library {
    name: "libbinder_accessor",
    srcs: ["cpp/binder_access.cpp"],
    vendor_available: true,
    shared_libs: [
        "liblog",
        "libbinder_ndk",
    ],
    header_libs: ["jni_headers"],
    stl: "c++_shared",
    visibility: [":__subpackages__"],
}

android_app {
    name: "telemetry_java_sample_ivi_publisher",
    vendor: true,
    sdk_version: "system_current",
    srcs: [
        "java/sample_ivi_publisher/BinderServiceAccessor.java",
        "java/sample_ivi_publisher/IPublisherImpl.java",
        "java/sample_ivi_publisher/IPublisherSubscriptionImpl.java",
        "java/sample_ivi_publisher/JavaSampleIviPublisher.java",
        "rust/data_tunnel_publisher_error_report/error_report_publisher.proto",
    ],
    manifest: "java/sample_ivi_publisher/AndroidManifest.xml",
    static_libs: [
        "google.sdv.telemetry.configurable_publisher-V1-java",
        "libprotobuf-java-lite",
        "guava",
        "libtime-android",
        "libmdscommon_lib",
        "libmdslib_lib",
    ],
    proto: {
        type: "lite",
        local_include_dirs: [
            "rust/data_tunnel_publisher_error_report/error_report_publisher.proto",
        ],
    },
    optimize: {
        enabled: false,
    },
    privileged: true,
    jni_libs: ["libbinder_accessor"],
    use_embedded_native_libs: true,
    jni_uses_platform_apis: true,
}

android_app {
    name: "telemetry_java_sample_ivi_publisher_prod",
    product_specific: true,
    sdk_version: "system_current",
    srcs: [
        "java/sample_ivi_publisher/BinderServiceAccessor.java",
        "java/sample_ivi_publisher/IPublisherImpl.java",
        "java/sample_ivi_publisher/IPublisherSubscriptionImpl.java",
        "java/sample_ivi_publisher/JavaSampleIviPublisherProd.java",
        "rust/data_tunnel_publisher_error_report/error_report_publisher.proto",
    ],
    manifest: "java/sample_ivi_publisher/AndroidManifestProd.xml",
    static_libs: [
        "google.sdv.telemetry.configurable_publisher-V1-java",
        "libprotobuf-java-lite",
        "guava",
        "libtime-android",
        "libmdscommon_lib",
        "libmdslib_lib",
    ],
    proto: {
        type: "lite",
        local_include_dirs: [
            "rust/data_tunnel_publisher_error_report/error_report_publisher.proto",
        ],
    },
    optimize: {
        enabled: false,
    },
    privileged: true,
    jni_libs: ["libbinder_accessor"],
    use_embedded_native_libs: true,
    jni_uses_platform_apis: true,
}

rust_binary {
    name: "telemetry_rust_c_client",
    defaults: ["telemetry_rust_c_client_defaults"],
    vendor: true,
}

rust_protobuf {
    name: "libsample_publisher_proto",
    crate_name: "sample_publisher_proto",
    protos: [
        "rust/sample_publisher/sample_publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "configurable_publisher_source",
    vendor_available: true,
}

rust_defaults {
    name: "telemetry_sample_getter_publisher_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "rust/sample_getter_publisher/main.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libsample_publisher_proto",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    vendor: true,
}

rust_binary {
    name: "telemetry_sample_getter_publisher",
    defaults: ["telemetry_sample_getter_publisher_defaults"],
}

rust_test {
    name: "telemetry_sample_getter_publisher_unit_tests",
    defaults: ["telemetry_sample_getter_publisher_defaults"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}

rust_defaults {
    name: "telemetry_sample_publisher_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
