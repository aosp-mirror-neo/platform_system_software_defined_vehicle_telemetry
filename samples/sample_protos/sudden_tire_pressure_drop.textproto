# Copyright 2024 Google LLC

# Scenario
# Creates a report when the tire pressure in any of the wheels drops suddenly below |a miscellanous number|

uuid: "9f7f64be-3594-463f-8b96-742e23da037c"
version: 1

# ------------------------ DESCRIPTOR PROTOS -----------------------------------

descriptor_protos {
    message_type {
        name: "Report"
        field {
          type: TYPE_DOUBLE
          name: "tire_pressure"
          number: 1
        }
        field {
          type: TYPE_DOUBLE
          name: "tire_pressure_change"
          number: 2
        }
      }

      message_type {
        name: "TirePressure"
        field {
          type: TYPE_DOUBLE
          name: "front_left"
          number: 1
        }
        field {
            type: TYPE_DOUBLE
            name: "front_right"
            number: 2
          }
          field {
            type: TYPE_DOUBLE
            name: "rear_left"
            number: 3
          }
          field {
            type: TYPE_DOUBLE
            name: "rear_right"
            number: 4
          }
      }
}

# ----------------------------- TRIGGERS ---------------------------------------

triggers {
    name: "new_tire_pressure_data"
    data_trigger {
        publisher_name: "tire_pressure_publisher"
    }
}

triggers {
    name: "new_tire_pressure_change_aggregation"
    data_trigger {
        publisher_name: "tire_pressure_change_aggregation"
    }
}

triggers {
    name: "tire_pressure_drop_front_left"
    conditional_trigger {
        trigger_names: "new_tire_pressure_change_aggregation"
        selector_node_index: 4
        is_true {}
    }
}

triggers {
    name: "tire_pressure_drop_front_right"
    conditional_trigger {
        trigger_names: "new_tire_pressure_change_aggregation"
        selector_node_index: 9
        is_true {}
    }
}

triggers {
    name: "tire_pressure_drop_rear_left"
    conditional_trigger {
        trigger_names: "new_tire_pressure_change_aggregation"
        selector_node_index: 14
        is_true {}
    }
}

triggers {
    name: "tire_pressure_drop_rear_right"
    conditional_trigger {
        trigger_names: "new_tire_pressure_change_aggregation"
        selector_node_index: 19
        is_true {}
    }
}




# ----------------------------- PUBLISHERS -------------------------------------

publishers {
    name: "tire_pressure_publisher"
    service_publisher {
        service_name: "com.google.sdv.telemetry.samples.DataTunnelPublisherTirePressure#TirePressure"
    }
}

publishers {
    name: "tire_pressure_change_aggregation"
    aggregation_publisher {
        trigger_names: "new_tire_pressure_data"
        reset_on_get: false
        message_builder {
            message_type: ".TirePressure"
            field_assignments {
                field_name: "front_left"
                delta_aggregation {
                    expression_node_index: 2
                 }
            }
            field_assignments {
                field_name: "front_right"
                delta_aggregation {
                    expression_node_index: 7
                 }
            }
            field_assignments {
                field_name: "rear_left"
                delta_aggregation {
                    expression_node_index: 12
                 }
            }
            field_assignments {
                field_name: "rear_right"
                delta_aggregation {
                    expression_node_index: 17
                 }
            }
        }
    }
}

# -------------------------- EXPRESSION NODES ----------------------------------

# -------------------------- CONSTANTS -----------------------------------------

# index 0
# x
expression_nodes {
    constant_leaf_node {
      float_value: 2.0
    }
  }

# index 1
# y
expression_nodes {
    constant_leaf_node {
      float_value: 0.09
    }
}

# -------------------------- FRONT LEFT TIRE PRESSURE --------------------------
# index 2
# value
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_publisher"
        field_names: "front_left"
      }
}

# index 3
# delta
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_change_aggregation"
        field_names: "front_left"
      }
}

# index 4
# drop
# tire pressure below x AND diff to previous tire pressure > y
expression_nodes {
    combination_node {
        logical_operator: AND
        left_index: 5
        right_index: 6
    }
}

# index 5
# tire pressue < x
expression_nodes {
    combination_node {
        relational_operator: LT
        left_index: 2
        right_index: 0
    }
}

# index 6
# diff to previous tire pressure > y
expression_nodes {
    combination_node {
        relational_operator: GT
        left_index: 3
        right_index: 1
    }
}

# -------------------------- FRONT RIGHT TIRE PRESSURE -------------------------
# index 7
# value
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_publisher"
        field_names: "front_right"
      }
}

# index 8
# delta
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_change_aggregation"
        field_names: "front_right"
      }
}

# index 9
# drop
# tire pressure below x AND diff to previous tire pressure > y
expression_nodes {
    combination_node {
        logical_operator: AND
        left_index: 10
        right_index: 11
    }
}

# index 10
# tire pressue < x
expression_nodes {
    combination_node {
        relational_operator: LT
        left_index: 7
        right_index: 0
    }
}

# index 11
# diff to previous tire pressure > y
expression_nodes {
    combination_node {
        relational_operator: GT
        left_index: 8
        right_index: 1
    }
}

# -------------------------- BACK LEFT TIRE PRESSURE ---------------------------
# index 12
# value
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_publisher"
        field_names: "rear_left"
      }
}

# index 13
# delta
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_change_aggregation"
        field_names: "rear_left"
      }
}

# index 14
# drop
# tire pressure below x AND diff to previous tire pressure > y
expression_nodes {
    combination_node {
        logical_operator: AND
        left_index: 15
        right_index: 16
    }
}

# index 15
# tire pressue < x
expression_nodes {
    combination_node {
        relational_operator: LT
        left_index: 12
        right_index: 0
    }
}

# index 16
# diff to previous tire pressure > y
expression_nodes {
    combination_node {
        relational_operator: GT
        left_index: 13
        right_index: 1
    }
}

# -------------------------- BACK RIGHT TIRE PRESSURE --------------------------
# index 17
# value
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_publisher"
        field_names: "rear_right"
      }
}

# index 18
# delta
expression_nodes {
    field_leaf_node {
        publisher_name: "tire_pressure_change_aggregation"
        field_names: "rear_right"
      }
}

# index 19
# drop
# tire pressure below x AND diff to previous tire pressure > y
expression_nodes {
    combination_node {
        logical_operator: AND
        left_index: 20
        right_index: 21
    }
}

# index 20
# tire pressue < x
expression_nodes {
    combination_node {
        relational_operator: LT
        left_index: 17
        right_index: 0
    }
}

# index 21
# diff to previous tire pressure > y
expression_nodes {
    combination_node {
        relational_operator: GT
        left_index: 18
        right_index: 1
    }
}



# ------------------------ METRIC REPORT CONFIGS -------------------------------

metrics_report_configs {
    name: "Sudden_tire_pressure_drop_front_left_wheel"
    trigger_names: "tire_pressure_drop_front_left"
    report_incomplete: false
    message_builder {
        message_type: ".Report"
        field_assignments {
            field_name: "tire_pressure"
            no_aggregation {
                expression_node_index: 2
            }
        }
        field_assignments {
            field_name: "tire_pressure_change"
            no_aggregation {
                expression_node_index: 3
            }
        }
    }
}

metrics_report_configs {
    name: "Sudden_tire_pressure_drop_front_right_wheel"
    trigger_names: "tire_pressure_drop_front_right"
    report_incomplete: false
    message_builder {
        message_type: ".Report"
        field_assignments {
            field_name: "tire_pressure"
            no_aggregation {
                expression_node_index: 7
            }
        }
        field_assignments {
            field_name: "tire_pressure_change"
            no_aggregation {
                expression_node_index: 8
            }
        }
    }
}

metrics_report_configs {
    name: "Sudden_tire_pressure_drop_rear_left_wheel"
    trigger_names: "tire_pressure_drop_rear_left"
    report_incomplete: false
    message_builder {
        message_type: ".Report"
        field_assignments {
            field_name: "tire_pressure"
            no_aggregation {
                expression_node_index: 12
            }
        }
        field_assignments {
            field_name: "tire_pressure_change"
            no_aggregation {
                expression_node_index: 13
            }
        }
    }
}

metrics_report_configs {
    name: "Sudden_tire_pressure_drop_rear_right_wheel"
    trigger_names: "tire_pressure_drop_rear_right"
    report_incomplete: false
    message_builder {
        message_type: ".Report"
        field_assignments {
            field_name: "tire_pressure"
            no_aggregation {
                expression_node_index: 17
            }
        }
        field_assignments {
            field_name: "tire_pressure_change"
            no_aggregation {
                expression_node_index: 18
            }
        }
    }
}
