# Copyright 2024 Google LLC

uuid: "aa27583c-96a5-4a67-adad-d15e00c0f12b"
version: 1

# ------------------------ DESCRIPTOR PROTOS -----------------------------------

descriptor_protos {
    message_type {
        name: "SpeedData"
        field {
          type: TYPE_DOUBLE
          name: "average_speed"
          number: 1
        }
      }

      message_type {
        name: "SpeedDataList"
        field {
          type: TYPE_DOUBLE
          label: LABEL_REPEATED
          name: "average_speed"
          number: 1
        }
      }
}

# ----------------------------- TRIGGERS ---------------------------------------

triggers {
    name: "new_speed_data"
    data_trigger {
        publisher_name: "speed_publisher"
    }
}

triggers {
    name: "every_second"
    periodic_trigger {
        interval {
            seconds: 1
            nanos: 0
        }
    }
}

triggers {
    name: "regular_trigger"
    periodic_trigger {
        interval {
            seconds: 10
            nanos: 0
        }
    }
}

# ----------------------------- PUBLISHERS -------------------------------------

publishers {
    name: "speed_publisher"
    service_publisher {
        service_name: "DataTunnelSpeedSamplePublisher"
    }
}

publishers {
    name: "average_speed_aggregation"
    aggregation_publisher {
        trigger_names: "new_speed_data"
        reset_on_get: true
        message_builder {
            message_type: ".SpeedData"
            field_assignments {
                field_name: "average_speed"
                avg_aggregation {
                    expression_node_index: 0
                }
            }
        }
    }
}

publishers {
    name: "average_speed_list_aggregation"
    aggregation_publisher {
        trigger_names: "every_second"
        reset_on_get: true
        message_builder {
            message_type: ".SpeedDataList"
            field_assignments {
                field_name: "average_speed"
                vector_aggregation {
                    expression_node_index: 1
                }
            }
        }
    }
}

# -------------------------- EXPRESSION NODES ----------------------------------


# index 0
expression_nodes {
    field_leaf_node {
        publisher_name: "speed_publisher"
        field_names: "speed"
      }
}

# index 1
expression_nodes {
    field_leaf_node {
        publisher_name: "average_speed_aggregation"
        field_names: "average_speed"
      }
  }

  # index 2
expression_nodes {
    field_leaf_node {
        publisher_name: "average_speed_list_aggregation"
        field_names: "average_speed"
      }
  }


# ------------------------ METRIC REPORT CONFIGS -------------------------------

metrics_report_configs {
    name: "average_speed_list"
    trigger_names: "regular_trigger"
    report_incomplete: true

    message_builder {
        message_type: ".SpeedDataList"
        field_assignments {
            field_name: "average_speed"
            no_aggregation {
                expression_node_index: 2
            }
        }
    }
}