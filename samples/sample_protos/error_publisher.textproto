# ------------------------ DESCRIPTOR PROTOS -----------------------------------
descriptor_protos {
    name: "samples/rust/data_tunnel_publisher_error_report/error_report_publisher.proto"
    package: "com.google.sdv.telemetry.samples"
    message_type {
    name: "ErrorReportData"
    field {
        name: "timestamp"
        number: 1
        label: LABEL_OPTIONAL
        type: TYPE_UINT64
        json_name: "timestamp"
    }
    field {
        name: "error_info"
        number: 2
        label: LABEL_OPTIONAL
        type: TYPE_MESSAGE
        type_name: ".com.google.sdv.telemetry.samples.ErrorInfo"
        json_name: "errorInfo"
    }
    }
    message_type {
    name: "ErrorInfo"
    field {
        name: "code"
        number: 1
        label: LABEL_OPTIONAL
        type: TYPE_INT32
        json_name: "code"
    }
    field {
        name: "severity"
        number: 2
        label: LABEL_OPTIONAL
        type: TYPE_ENUM
        type_name: ".com.google.sdv.telemetry.samples.Severity"
        json_name: "severity"
    }
    field {
        name: "title"
        number: 3
        label: LABEL_OPTIONAL
        type: TYPE_STRING
        json_name: "title"
    }
    field {
        name: "description"
        number: 4
        label: LABEL_OPTIONAL
        type: TYPE_STRING
        json_name: "description"
    }
    field {
        name: "memory_dump"
        number: 5
        label: LABEL_OPTIONAL
        type: TYPE_BYTES
        json_name: "memoryDump"
    }
    }
    enum_type {
    name: "Severity"
    value {
        name: "UNSPECIFIED"
        number: 0
    }
    value {
        name: "FATAL"
        number: 1
    }
    value {
        name: "ERROR"
        number: 2
    }
    value {
        name: "WARN"
        number: 3
    }
    value {
        name: "INFO"
        number: 4
    }
    value {
        name: "TRACE"
        number: 5
    }
    }
    syntax: "proto3"
}
# ----------------------------- TRIGGERS ---------------------------------------

triggers {
    name: "new_error_report"
    data_trigger {
        publisher_name: "error_report_publisher"
    }
}


# ----------------------------- PUBLISHERS -------------------------------------

publishers {
    name: "error_report_publisher"
    service_publisher {
        service_name: "java_sample_ivi_publisher"
    }
}

# -------------------------- EXPRESSION NODES ----------------------------------


# index 0
expression_nodes {
    field_leaf_node {
        publisher_name: "error_report_publisher"
        field_names: "error_info"
        field_names: "title"
      }
}

# index 1
expression_nodes {
    field_leaf_node {
        publisher_name: "error_report_publisher"
        field_names: "error_info"
        field_names: "description"
      }
}

# index 2
expression_nodes {
    field_leaf_node {
        publisher_name: "error_report_publisher"
        field_names: "error_info"
        field_names: "severity"
      }
}

# index 3
expression_nodes {
    field_leaf_node {
        publisher_name: "error_report_publisher"
        field_names: "timestamp"
      }
}

# index 4
expression_nodes {
    field_leaf_node {
        publisher_name: "error_report_publisher"
        field_names: "error_info"
        field_names: "memory_dump"
      }
}

# ------------------------ METRIC REPORT CONFIGS -------------------------------

metrics_report_configs {
    name: "error_report"
    trigger_names: "new_error_report"
    report_incomplete: false

    message_builder {
        message_type: ".com.google.sdv.telemetry.samples.ErrorReportData"
        field_assignments {
            field_name: "timestamp"
            no_aggregation {
                expression_node_index: 3
            }
        }
    }
}