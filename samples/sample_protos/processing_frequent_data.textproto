uuid: "b2453b41-8c09-4709-88c5-627d39ed3711"
version: 1

# ------------------------ DESCRIPTOR PROTOS -----------------------------------

descriptor_protos {
    message_type {
        name: "SpeedVector"
        field {
          label: LABEL_REPEATED
          type: TYPE_INT64
          name: "speed"
          number: 1
        }
      }

      message_type {
        name: "UselessMessage"
        field {
          type: TYPE_BOOL
          name: "useless_field"
          number: 1
        }
      }
}

# ----------------------------- TRIGGERS ---------------------------------------

triggers {
    name: "new_speed_data"
    data_trigger {
        publisher_name: "speed_publisher"
    }
}

triggers {
    name: "report_trigger"
    periodic_trigger {
        interval {
            seconds: 60
            nanos: 0
        }
    }
}

# ----------------------------- PUBLISHERS -------------------------------------

publishers {
    name: "speed_publisher"
    service_publisher {
        service_name: "DataTunnelSpeedSamplePublisher"
    }
}

publishers {
    name: "speed_vector_aggregation"
    aggregation_publisher {
        trigger_names: "new_speed_data"
        reset_on_get: false
        message_builder {
            message_type: ".SpeedVector"
            field_assignments {
                field_name: "speed"
                vector_aggregation {
                    expression_node_index: 0
                    max_length: 10000
                }
            }
        }
    }
}

publishers {
    name: "unnecassary_calculation"
    aggregation_publisher {
        trigger_names: "new_speed_data"
        reset_on_get: false
        message_builder {
            message_type: ".UselessMessage"
            field_assignments {
                field_name: "useless_field"
                no_aggregation {
                    expression_node_index: 1
                }
            }
        }
    }
}

# -------------------------- EXPRESSION NODES ----------------------------------


# index 0
expression_nodes {
    field_leaf_node {
        publisher_name: "speed_publisher"
        field_names: "speed"
      }
}

# index 1
expression_nodes {
    combination_node {
        relational_operator: CONTAINS
        left_index: 2
        right_index: 3
    }
}

# index 2
# TODO: NOT A VECTOR?
expression_nodes {
    field_leaf_node {
        publisher_name: "speed_vector_aggregation"
        field_names: "speed"
      }
  }

  # index 3
  expression_nodes {
    constant_leaf_node {
      int64_value: 3000
    }
  }




# ------------------------ METRIC REPORT CONFIGS -------------------------------

metrics_report_configs {
    name: "Lots_of_frequent_unnecessary_processing"
    trigger_names: "report_trigger"
    report_incomplete: false

    message_builder {
        message_type: ".UselessMessage"
        field_assignments {
            field_name: "useless_field"
            no_aggregation {
                expression_node_index: 1
            }
        }
    }
}