# proto-message: MetricsConfig

uuid: "c6005cea-8fde-436a-9f29-c12f06a10c10"
version: 01
descriptor_protos {
  name: "metrics.proto"
  package: "android.automotive.telemetry.messages"

  message_type {
    name: "SampleReport"
    field {
      label: LABEL_OPTIONAL
      type: TYPE_INT32
      name: "sample_data"

      number: 1
    }
  }
}

publishers {
  name: "TestPublisher"
  service_publisher { service_name: "SampleService" }
}

expression_nodes { field_leaf_node { publisher_name: "TestPublisher" field_names: "sample_data" } }

triggers {
  name: "StartTrigger"
  periodic_trigger { interval { seconds: 2 } }
}
triggers {
  name: "TestPublisherTrigger"
  data_trigger { publisher_name: "TestPublisher" }
}

start_trigger_name: "StartTrigger"
metrics_report_configs {
  name: "SampleReport"
  trigger_names: "TestPublisherTrigger"
  message_builder {
    message_type: ".android.automotive.telemetry.messages.SampleReport"
    field_assignments {
      field_name: "sample_data"
      no_aggregation { expression_node_index: 0 }
    }
  }
}
