// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "libsdv_telemetry_sample_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        // keep-sorted end
    ],
}

rust_library {
    name: "libsdv_telemetry_sample_utils",
    defaults: ["libsdv_telemetry_sample_utils_defaults"],
    crate_name: "sdv_telemetry_sample_utils",
    product_available: true,
    vendor_available: true,
}

rust_test {
    name: "sdv_mt_telemetry_unit_sample_utils_test",
    defaults: ["libsdv_telemetry_sample_utils_defaults"],
    rustlibs: [
        // keep-sorted start
        "libsdv_telemetry_utils",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    data: [
        // keep-sorted start
        ":sdv_telemetry_config_without_service_publishers_proto",
        // keep-sorted end
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}
