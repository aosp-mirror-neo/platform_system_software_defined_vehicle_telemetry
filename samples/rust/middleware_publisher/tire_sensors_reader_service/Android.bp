// Copyright 2024 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "telemetry_sample_middleware_publisher",
    crate_name: "telemetry_sample_middleware_publisher",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libcom_sdv_telemetry_sample_tire_status_rpc_rs",
        "libfutures",
        "liblog_rust",
        "libparking_lot",
        "libprotobuf",
        "librand",
        "libsdv_comms_rs",
        "libsdv_log_rust",
        "libsdv_mw_rs_com_sdv_telemetry_sample_tire_sensors_reader",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_status_rs",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_sample_middleware_proto",
        "libsdv_telemetry_utils",
        "libtokio",
        "libtokio_stream",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    defaults: ["sdv_telemetry@rust_defaults"],
    vendor: true,
}
