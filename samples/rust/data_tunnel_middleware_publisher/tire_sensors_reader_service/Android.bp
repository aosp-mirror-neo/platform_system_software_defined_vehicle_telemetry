// Copyright 2024 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "telemetry_sample_data_tunnel_publisher_middleware",
    crate_name: "telemetry_sample_data_tunnel_publisher_middleware",
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "liblog_rust",
        "libprotobuf",
        "librand",
        "libsdv_comms_rs",
        "libsdv_log_rust",
        "libsdv_mw_rs_com_sdv_telemetry_sample_tire_sensors_reader",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_sample_middleware_proto",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    defaults: ["sdv_telemetry@rust_defaults"],
    vendor: true,
}
