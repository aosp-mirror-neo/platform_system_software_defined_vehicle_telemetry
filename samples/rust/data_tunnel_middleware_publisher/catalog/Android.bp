// Copyright 2024 Google LLC
package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_protobuf {
    name: "libsdv_telemetry_sample_middleware_proto",
    crate_name: "sdv_telemetry_sample_middleware_proto",
    protos: [
        "**/*.proto",
    ],
    source_stem: "sdv_telemetry_sample_middleware_proto_source",
    rustlibs: [
        "libvsidl_v1_proto_rs",
    ],
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor_available: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

filegroup {
    name: "telemetry_catalog_protos_with_bp_file",
    srcs: [
        ":telemetry_catalog_protos",
        "Android.bp",
    ],
}

filegroup {
    name: "telemetry_catalog_protos",
    srcs: [
        "**/*.proto",
        "**/*.vsidl",
    ],
}
