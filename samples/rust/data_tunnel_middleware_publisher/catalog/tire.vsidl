package: "com.sdv.telemetry.sample"

sdv_service_bundle {
    name: "TireSensorsReader"

    publisher {
      type: "TirePressure"
      instance: "FRONT_LEFT"
      instance: "FRONT_RIGHT"
      instance: "REAR_LEFT"
      instance: "REAR_RIGHT"
    }

    publisher {
      type: "TireTemperature"
    }

    publisher {
      type: "VehicleSpeed"
    }

    unit_type {
      type: "TirePressure"
    }

    unit_type {
      type: "TireTemperature"
    }

    unit_type {
      type: "VehicleSpeed"
    }
}
