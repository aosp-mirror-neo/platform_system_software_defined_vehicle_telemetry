rust_defaults {
    name: "sdv_telemetry_get_proto_file_descriptors_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["src/main.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libclap",
        "libprotobuf",
        "libprotobuf_parse",
        // keep-sorted end
    ],
}

rust_binary_host {
    name: "sdv_telemetry_get_proto_file_descriptors",
    defaults: ["sdv_telemetry_get_proto_file_descriptors_defaults"],
    required: ["aprotoc"],
    target: {
        linux_bionic_x86_64: {
            // Without this, the lunch target
            // `mainline_modules_sdks-trunk_staging-userdebug` generates the
            // following error:
            //
            // > module "sdv_telemetry_get_proto_file_descriptors" variant
            // > "linux_bionic_x86_64": OS mismatch between
            // > "sdv_telemetry_get_proto_file_descriptors" (linux_bionic) and
            // > "aprotoc" (linux_glibc)
            enabled: false,
        },
    },
}

genrule {
    name: "sdv_telemetry_get_proto_file_descriptors_test_data",
    tools: ["sdv_telemetry_get_proto_file_descriptors"],
    tool_files: [":libprotobuf-internal-protos"],
    srcs: ["src/test_data/sample_message.proto"],
    cmd: "$(location sdv_telemetry_get_proto_file_descriptors) " +
        "--include-path ./tools/src/external/protobuf/src " +
        "--out-dir \"$(genDir)\" " +
        "\"$(location src/test_data/sample_message.proto)\"",
    out: [
        // keep-sorted start
        "descriptor.binpb",
        "descriptor.txt",
        "descriptor.txtpb",
        "descriptor_set.binpb",
        "descriptor_set.txt",
        "descriptor_set.txtpb",
        // keep-sorted end
    ],
}

rust_test_host {
    name: "sdv_mt_telemetry_unit_get_proto_file_descriptors_test",
    defaults: ["sdv_telemetry_get_proto_file_descriptors_defaults"],
    data: [":sdv_telemetry_get_proto_file_descriptors_test_data"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        "sdv-host-unit-tests",
        // keep-sorted end
    ],
    test_options: {
        unit_test: true,
    },
    auto_gen_config: true,
}
