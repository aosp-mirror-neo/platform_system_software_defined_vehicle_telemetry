// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

cc_defaults {
    name: "libtelemetry_c_defaults",
    defaults: [
        "sdv_telemetry@cc_defaults",
    ],
    shared_libs: [
        "libprotobuf-cpp-full",
        "libbinder",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "libbase",
    ],
    static_libs: ["libgtest"],
}

cc_library {
    name: "libtelemetry_c",
    defaults: [
        "libtelemetry_c_defaults",
    ],
    srcs: [
        "src/callback_container.cpp",
        "src/api_status_listener_impl.cpp",
        "src/misc_status_listener_impl.cpp",
        "src/report_listener_impl.cpp",
        "src/report_ready_listener_impl.cpp",
        "src/telemetry_service.cpp",
        "src/lib.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    export_include_dirs: [
        "export",
    ],
    shared_libs: [
        "google.sdv.telemetry-V1-ndk",
        "libsdvtelemetry_proto_cpp",
    ],
    vendor_available: true,
    system_ext_specific: true,
}

rust_library {
    name: "libsdv_telemetry_rust_wrapper",
    defaults: ["sdv_telemetry@rust_defaults"],
    crate_name: "sdv_telemetry_rust_wrapper",
    srcs: ["rust_wrapper/telemetry_service_rust_wrapper.rs"],
    rustlibs: [
        "libfutures",
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "libsdv_telemetry_bindgen",
        "libsdv_telemetry_status_codes_bindgen",
        "libthiserror",
        "libtokio",
    ],
    proc_macros: [
        "libasync_trait",
        "libclap_derive",
    ],
    system_ext_specific: true,
    vendor_available: true,
    visibility: ["//visibility:public"],
}
