// Copyright 2023 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

cc_defaults {
    name: "libtelemetry_c_defaults",
    defaults: [
        "sdv_telemetry@cc_defaults",
    ],
    shared_libs: [
        // keep-sorted start
        "libbase",
        "libbinder_ndk",
        "libprotobuf-cpp-full",
        "libutils",
        // keep-sorted end
    ],
    cflags: [
        // Make sure that the log tag is 23 characters or less, otherwise it
        // will be truncated!
        "-DLOG_TAG=\"TelemetryClientLibC\"",
    ],
}

cc_library {
    name: "libtelemetry_c",
    defaults: [
        "libtelemetry_c_defaults",
    ],
    srcs: [
        // keep-sorted start
        "src/api_status_listener_impl.cpp",
        "src/config_list_listener_impl.cpp",
        "src/lib.cpp",
        "src/misc_status_listener_impl.cpp",
        "src/report_listener_impl.cpp",
        "src/report_ready_listener_impl.cpp",
        "src/telemetry_service_client.cpp",
        // keep-sorted end
    ],
    local_include_dirs: [
        "include",
    ],
    export_include_dirs: [
        "export",
    ],
    shared_libs: [
        // keep-sorted start
        "google.sdv.telemetry-V1-ndk",
        "libsdv_telemetry_proto_cpp",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_bindgen {
    name: "libsdv_telemetry_bindgen",
    crate_name: "sdv_telemetry_bindgen",
    wrapper_src: "export/lib.h",
    source_stem: "bindings",
    shared_libs: [
        // keep-sorted start
        "libtelemetry_c",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_test {
    name: "libsdv_telemetry_bindgen_tests",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        ":libsdv_telemetry_bindgen",
    ],
    crate_name: "sdv_telemetry_bindgen_tests",
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,

    // Disable all lints because the generated code is not guaranteed to be
    // lint-free.
    clippy_lints: "none",
    lints: "none",
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}

rust_bindgen {
    name: "libsdv_telemetry_status_codes_bindgen",
    crate_name: "sdv_telemetry_status_codes_bindgen",
    wrapper_src: "export/status_codes.h",
    cpp_std: "gnu++17",
    source_stem: "bindings",
    vendor_available: true,
}

rust_test {
    name: "libsdv_telemetry_status_codes_bindgen_tests",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        ":libsdv_telemetry_status_codes_bindgen",
    ],
    crate_name: "sdv_telemetry_status_codes_bindgen_tests",
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,

    // Disable all lints because the generated code is not guaranteed to be
    // lint-free.
    clippy_lints: "none",
    lints: "none",
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}

rust_defaults {
    name: "libsdv_telemetry_rust_wrapper_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["rust_wrapper/telemetry_service_rust_wrapper.rs"],
    rustlibs: [
        // keep-sorted start
        "libbinder_rs",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_telemetry_bindgen",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_status_codes_bindgen",
        "libthiserror",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        "libclap_derive",
        // keep-sorted end
    ],
}

rust_library {
    name: "libsdv_telemetry_rust_wrapper",
    defaults: ["libsdv_telemetry_rust_wrapper_defaults"],
    crate_name: "sdv_telemetry_rust_wrapper",
    vendor_available: true,
    visibility: ["//visibility:public"],
}

rust_test {
    name: "libsdv_telemetry_rust_wrapper_tests",
    defaults: ["libsdv_telemetry_rust_wrapper_defaults"],
    crate_name: "sdv_telemetry_rust_wrapper_tests",
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,

    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
