// Copyright 2023 Google LLC. All Rights Reserved.

package {
    default_applicable_licenses: ["sdv_license"],
}

cc_defaults {
    name: "telemetry_defaults",
    cflags: [
        "-Werror",
        "-Wall",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
    ],
    shared_libs: [
        "libprotobuf-cpp-full",
        "libbinder",
        "liblog",
        "libutils",
        "libbase",
    ],
    static_libs: ["libgtest"],
}

cc_library {
    name: "libtelemetry_c",
    srcs: [
        "src/callback_container.cpp",
        "src/status_listener_impl.cpp",
        "src/report_listener_impl.cpp",
        "src/report_ready_listener_impl.cpp",
        "src/telemetry_service.cpp",
        "src/lib.cpp",
    ],
    defaults: [
        "telemetry_defaults",
    ],
    local_include_dirs: [
        "include",
    ],
    export_include_dirs: [
        "export",
    ],
    shared_libs: [
        "google.sdv.telemetry-V1-cpp",
        "libsdvtelemetry_proto_cpp",
    ],
    vendor_available: true,
    system_ext_specific: true,
}

rust_library {
    name: "libsdv_telemetry_rust_wrapper",
    crate_name: "sdv_telemetry_rust_wrapper",
    srcs: ["rust_wrapper/telemetry_service_rust_wrapper.rs"],
    rustlibs: [
        "libfutures",
        "liblog_rust",
        "libbinder_rs",
        "liblogger",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
        "libsdv_telemetry_bindgen",
        "libstatus_codes_bindgen",
        "libtokio",
    ],
    proc_macros: [
        "libasync_trait",
        "libclap_derive",
    ],
    system_ext_specific: true,
    vendor_available: true,
    visibility: ["//visibility:public"],
}
