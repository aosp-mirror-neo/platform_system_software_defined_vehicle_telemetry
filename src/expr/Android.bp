rust_defaults {
    name: "sdv_ast_defaults",
    host_supported: true,
    rustlibs: [
        "liblog_rust",
        "liblogger",
        "libsdv_log_rust",
        "libsdvtelemetry_proto_rust",
        "libprotobuf",
    ],
}

rust_library {
    name: "libsdv_node_value",
    crate_name: "sdv_node_value",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "node_value.rs",
    ],
}

rust_library {
    name: "libsdv_ast_traversal",
    crate_name: "sdv_ast",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "ast.rs",
    ],
    rustlibs: [
        "libsdv_node_value",
    ],
}

rust_binary {
    name: "ast",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "main.rs",
    ],
    rustlibs: [
        "libsdv_ast_traversal",
    ],
}

//////////////////// Test modules below /////////////////////
rust_test_host {
    name: "sdv_node_value_unit_tests",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "node_value.rs",
    ],
    rustlibs: [
        "libsdv_node_value",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    test_options: {
        unit_test: true,
    },
    auto_gen_config: true,
}

rust_test_host {
    name: "sdv_ast_unit_tests",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "ast.rs",
    ],
    rustlibs: [
        "libsdv_ast_traversal",
        "libsdv_node_value",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    test_options: {
        unit_test: true,
    },
    auto_gen_config: true,
}
