rust_defaults {
    name: "sdv_ast_defaults",
    host_supported: true,
    rustlibs: [
        "liblog_rust",
        "liblogger",
        "libsdv_log_rust",
        "libsdvtelemetry_proto_rust",
        "libthiserror",
        "libprotobuf",
    ],
}

rust_library {
    name: "libsdv_ast_traversal",
    crate_name: "sdv_ast",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "ast.rs",
    ],
}

rust_binary {
    name: "ast",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "main.rs",
    ],
    rustlibs: [
        "liblazy_static",
        "libsdv_ast_traversal",
        "libsdv_telem_expr_parser",
        "libsdv_telem_test_proto",
    ],
}

rust_test_host {
    name: "sdv_ast_unit_tests",
    defaults: ["sdv_ast_defaults"],
    srcs: [
        "ast.rs",
    ],
    rustlibs: [
        "liblazy_static",
        "libsdv_ast_traversal",
        "libsdv_telem_test_proto",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    target: {
        host: {
            data_libs: [
                "liblog",
                "libc++",
            ],
        },
    },
}
