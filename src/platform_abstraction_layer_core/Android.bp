// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

sysprop_library {
    name: "sdv_telemetry_platform_abstraction_layer_core_sysprops",
    srcs: ["PALCore.sysprop"],
    property_owner: "Vendor",
    device_specific: true,
}

rust_defaults {
    name: "libsdv_telemetry_platform_abstraction_layer_core_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.vpm-V1-rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "libfutures",
        "liblog_rust",
        "libparking_lot",
        "libpersistent_binder",
        "libsdv_telemetry_platform_abstraction_layer",
        "libsdv_telemetry_platform_abstraction_layer_core_sysprops_rust",
        "libsdv_telemetry_time_wrapper",
        "libtokio",
        "libtokio_stream",
        "libtokio_util",
        // keep-sorted end
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_library {
    name: "libsdv_telemetry_platform_abstraction_layer_core",
    visibility: ["//system/software_defined_vehicle/telemetry:__subpackages__"],
    defaults: ["libsdv_telemetry_platform_abstraction_layer_core_defaults"],
    crate_name: "sdv_telemetry_platform_abstraction_layer_core",
    vendor_available: true,
}

rust_test {
    name: "sdv_mt_telemetry_unit_platform_abstraction_layer_core_test",
    defaults: ["libsdv_telemetry_platform_abstraction_layer_core_defaults"],
    crate_name: "sdv_telemetry_platform_abstraction_layer_core_unit_tests",
    rustlibs: [
        // keep-sorted start
        "libgoogletest_rust",
        "libmockall",
        "libsdv_telemetry_test_utils",
        // keep-sorted end
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
