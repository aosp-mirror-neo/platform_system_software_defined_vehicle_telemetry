// Copyright 2024 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "libsdv_telemetry_utils_macros_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libproc_macro2",
        "libquote",
        "libsyn",
        // keep-sorted end
    ],
}

rust_proc_macro {
    name: "libsdv_telemetry_utils_macros",
    defaults: ["libsdv_telemetry_utils_macros_defaults"],
    crate_name: "sdv_telemetry_utils_macros",
}

