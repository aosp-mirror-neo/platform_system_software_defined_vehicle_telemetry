package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_binder_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libbinder_rs",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    product_available: true,
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_binder_utils",
    visibility: ["//system/software_defined_vehicle/telemetry:__subpackages__"],
    defaults: ["libsdv_telemetry_binder_utils_defaults"],
    crate_name: "sdv_telemetry_binder_utils",
    min_sdk_version: "35",
}
