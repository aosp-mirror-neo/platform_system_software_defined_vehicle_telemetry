package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_protobuf {
    name: "libsdv_telemetry_test_proto",
    visibility: ["//system/software_defined_vehicle/telemetry:__subpackages__"],
    crate_name: "sdv_telemetry_test_proto",
    protos: ["test_message.proto"],
    proto_flags: [
        "-I external/protobuf/src",
    ],
    source_stem: "sdv_telemetry_test_proto",
    product_available: true,
    vendor_available: true,
}

rust_protobuf {
    name: "libsdv_telemetry_test_proto_bool_value",
    visibility: ["//system/software_defined_vehicle/telemetry:__subpackages__"],
    crate_name: "sdv_telemetry_test_proto_bool_value",
    protos: [
        "test_bool_value_1.proto",
        "test_bool_value_2.proto",
    ],
    source_stem: "sdv_telemetry_test_proto_bool_value",
    product_available: true,
    vendor_available: true,
}

rust_defaults {
    name: "libsdv_telemetry_test_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libdowncast_rs",
        "libgoogletest_rust",
        "liblazy_static",
        "liblog_rust",
        "liblogger",
        "libmatches",
        "libparking_lot",
        "libprotobuf",
        "librand",
        "libsdv_telemetry_test_proto",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libsdv_telemetry_test_utils_macros",
        // keep-sorted end
    ],
    product_available: true,
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_test_utils",
    visibility: [
        // keep-sorted start
        "//system/software_defined_vehicle/samples/telemetry:__subpackages__",
        "//system/software_defined_vehicle/telemetry:__subpackages__",
        // keep-sorted end
    ],
    defaults: ["libsdv_telemetry_test_utils_defaults"],
    crate_name: "sdv_telemetry_test_utils",
}

rust_test {
    name: "sdv_mt_telemetry_unit_test_utils_test",
    defaults: ["libsdv_telemetry_test_utils_defaults"],
    rustlibs: [
        // keep-sorted start
        "libtokio",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    test_options: {
        unit_test: true,
    },
    auto_gen_config: true,
}
