// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "libsdv_telemetry_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "libdowncast_rs",
        "libeither",
        "libfutures",
        "liblog_rust",
        "libparking_lot",
        "libprotobuf",
        "libsdv_status_rs",
        "libsdv_telemetry_binder_utils",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_service_publisher_accessor",
        "libsdv_telemetry_time_wrapper",
        "libsdv_telemetry_utils",
        "libstrum",
        "libthiserror",
        "libtokio",
        "libtokio_stream",
        "libtokio_util",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        "libsdv_telemetry_utils_macros",
        "libstrum_macros",
        // keep-sorted end
    ],
}

rust_library {
    name: "libsdv_telemetry",
    defaults: ["libsdv_telemetry_defaults"],
    crate_name: "sdv_telemetry",
    vendor_available: true,
}

rust_test {
    name: "libsdv_telemetry_unit_tests",
    defaults: ["libsdv_telemetry_defaults"],
    rustlibs: [
        // keep-sorted start
        "libgoogletest_rust",
        "liblazy_static",
        "libmockall",
        "librand",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_test_proto",
        "libsdv_telemetry_test_utils",
        "libsdv_telemetry_utils",
        "libtempfile",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
    vendor: true,
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
