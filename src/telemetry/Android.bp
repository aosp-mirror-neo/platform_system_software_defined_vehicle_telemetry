package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "libdowncast_rs",
        "libeither",
        "libfutures",
        "liblog_rust",
        "libparking_lot",
        "libprotobuf",
        "libsdv_dump",
        "libsdv_status_rs",
        "libsdv_telemetry_binder_utils",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_service_publisher_accessor",
        "libsdv_telemetry_time_wrapper",
        "libsdv_telemetry_utils",
        "libstrum",
        "libthiserror",
        "libtokio",
        "libtokio_stream",
        "libtokio_util",
        "libuuid",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        "libstrum_macros",
        // keep-sorted end
    ],
}

rust_library {
    name: "libsdv_telemetry",
    visibility: ["//system/software_defined_vehicle/telemetry/src/telemetry_service_agent:__subpackages__"],
    defaults: ["libsdv_telemetry_defaults"],
    crate_name: "sdv_telemetry",
    vendor_available: true,
    rustlibs: [
        // keep-sorted start
        "libsdv_telemetry_expr",
        "libsdv_telemetry_platform_abstraction_layer",
        // keep-sorted end
    ],
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_mt_telemetry_lib_unit_test",
    defaults: ["libsdv_telemetry_defaults"],
    rustlibs: [
        // keep-sorted start
        "libgoogletest_rust",
        "liblazy_static",
        "libmockall",
        "librand",
        "libsdv_telemetry_expr_with_test_utils",
        "libsdv_telemetry_platform_abstraction_layer_with_test_utils",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_test_proto",
        "libsdv_telemetry_test_proto_bool_value",
        "libsdv_telemetry_test_utils",
        "libsdv_telemetry_utils",
        "libtempfile",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
    vendor: true,
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
