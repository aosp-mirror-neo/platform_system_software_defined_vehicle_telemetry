package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_configurable_publisher_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V2-rust",
        "libanyhow",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "libdashmap",
        "liblog_rust",
        "libparking_lot",
        "libprotobuf",
        "libsdv_telemetry_binder_utils",
        "libsdv_telemetry_service_publisher_accessor",
        "libsdv_telemetry_utils",
        "libthiserror",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        "libclap_derive",
        // keep-sorted end
    ],
}

rust_library {
    name: "libsdv_telemetry_configurable_publisher",
    visibility: ["//visibility:public"],
    defaults: ["libsdv_telemetry_configurable_publisher_defaults"],
    crate_name: "sdv_telemetry_configurable_publisher",
    product_available: true,
    vendor_available: true,
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_mt_telemetry_unit_telemetry_configurable_publisher_test",
    defaults: ["libsdv_telemetry_configurable_publisher_defaults"],
    rustlibs: [
        // keep-sorted start
        "libgoogletest_rust",
        "librand",
        "libsdv_telemetry_test_utils",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
    system_ext_specific: true,
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
