// Copyright 2024 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "libsdv_telemetry_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libfutures",
        "liblazy_static",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libtokio",
        // keep-sorted end
    ],
    product_available: true,
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_utils",
    defaults: ["libsdv_telemetry_utils_defaults"],
    crate_name: "sdv_telemetry_utils",
}

rust_test {
    name: "libsdv_telemetry_utils_unit_tests",
    defaults: ["libsdv_telemetry_utils_defaults"],
    rustlibs: [
        // keep-sorted start
        "libsdv_telemetry_test_utils",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libpaste",
        "libsdv_telemetry_test_utils_macros",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
