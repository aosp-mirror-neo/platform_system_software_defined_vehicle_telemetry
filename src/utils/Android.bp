package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_utils_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libfutures",
        "liblazy_static",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libtokio",
        "libtokio_stream",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libsdv_telemetry_utils_macros",
        // keep-sorted end
    ],
    product_available: true,
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_utils",
    visibility: [
        // keep-sorted start
        "//system/software_defined_vehicle/samples/telemetry:__subpackages__",
        "//system/software_defined_vehicle/telemetry:__subpackages__",
        // keep-sorted end
    ],
    defaults: ["libsdv_telemetry_utils_defaults"],
    crate_name: "sdv_telemetry_utils",
}

rust_test {
    name: "sdv_mt_telemetry_unit_utils_test",
    defaults: ["libsdv_telemetry_utils_defaults"],
    rustlibs: [
        // keep-sorted start
        "libgoogletest_rust",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_test_utils",
        "libtempfile",
        // keep-sorted end
    ],
    data: [":sdv_telemetry_utils_test_data"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
