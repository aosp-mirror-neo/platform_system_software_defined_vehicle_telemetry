rust_defaults {
    name: "libsdv_telemetry_test_utils_macros_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "test_utils_macros.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libproc_macro2",
        "libquote",
        "libsyn",
        // keep-sorted end
    ],
}

rust_proc_macro {
    name: "libsdv_telemetry_test_utils_macros",
    defaults: ["libsdv_telemetry_test_utils_macros_defaults"],
    crate_name: "sdv_telemetry_test_utils_macros",
}

