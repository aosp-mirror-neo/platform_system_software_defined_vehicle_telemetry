rust_defaults {
    name: "libsdv_telemetry_test_utils_macros_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "test_utils_macros.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libproc_macro2",
        "libquote",
        "libsyn",
        // keep-sorted end
    ],
}

rust_proc_macro {
    name: "libsdv_telemetry_test_utils_macros",
    defaults: ["libsdv_telemetry_test_utils_macros_defaults"],
    crate_name: "sdv_telemetry_test_utils_macros",
}

rust_test_host {
    name: "libsdv_telemetry_test_utils_macros_tests",
    defaults: ["libsdv_telemetry_test_utils_macros_defaults"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}
