package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_comms_stack_wrapper_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["lib.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libasync_stream",
        "libdashmap",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libparking_lot",
        "libprotobuf",
        "libsdv_comms_rs",
        "libsdv_config_provider",
        "libsdv_proto_reflection_rs",
        "libsdv_status_rs",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_service_publisher_accessor",
        "libsdv_telemetry_utils",
        "libthiserror",
        "libtokio",
        "libtokio_stream",
        "libtokio_util",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    product_available: true,
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_comms_stack_wrapper",
    visibility: [
        // keep-sorted start
        "//system/software_defined_vehicle/samples/telemetry:__subpackages__",
        "//system/software_defined_vehicle/telemetry:__subpackages__",
        // keep-sorted end
    ],
    crate_name: "sdv_telemetry_comms_stack_wrapper",
    defaults: ["libsdv_telemetry_comms_stack_wrapper_defaults"],
}

rust_defaults {
    name: "telemetry_comms_stack_wrapper_tests_defaults",
    defaults: ["libsdv_telemetry_comms_stack_wrapper_defaults"],
    rustlibs: [
        // keep-sorted start
        "libgoogletest_rust",
        "liblazy_static",
        "libsdv_telemetry_test_proto_bool_value",
        "libsdv_telemetry_test_utils",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    target: {
        host: {
            data_libs: [
                // keep-sorted start
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libc++",
                "libcutils",
                "liblog",
                "libutils",
                // keep-sorted end
            ],
        },
    },
    auto_gen_config: true,
    system_ext_specific: true,
    vendor_available: false,
    product_available: false,
}

rust_test {
    name: "sdv_mt_telemetry_unit_comms_stack_wrapper_test",
    defaults: ["telemetry_comms_stack_wrapper_tests_defaults"],
    cfgs: ["unit_tests"],
    test_options: {
        unit_test: true,
    },
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}

rust_test {
    name: "sdv_mt_telemetry_integration_comms_stack_wrapper_test",
    defaults: ["telemetry_comms_stack_wrapper_tests_defaults"],
    cfgs: ["integration_tests"],
    data_bins: ["sdv_telemetry_comms_stack_wrapper_test_publisher"],
    // Use a custom test config template as per
    // https://source.android.com/docs/core/tests/vts/setup11, because we need
    // to ensure that the integration tests are run serially (so that they can
    // use `fork`), not in parallel, by adding the `--test-threads=1` flag to
    // the test execution.
    test_config_template: ":sdv_telemetry_integration_test_config_template",
    test_options: {
        unit_test: false,
    },
    rustlibs: [
        // keep-sorted start
        "libbinder_rs",
        "libnix",
        "librand",
        "libscopeguard",
        "libsdv_telemetry_test_proto",
        "libsdv_telemetry_test_proto_bool_value",
        "libsdv_telemetry_test_utils",
        // keep-sorted end
    ],
    // Requires root so the test can perform Binder calls to the data tunnel
    // agent.
    require_root: true,
}
