rust_binary {
    name: "sdv_telemetry_comms_stack_wrapper_test_publisher",
    visibility: ["//system/software_defined_vehicle/telemetry/src/comms_stack_wrapper"],
    crate_name: "sdv_telemetry_comms_stack_wrapper_test_publisher",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["test_publisher.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libclap",
        "libprotobuf",
        "libsdv_comms_rs",
        "libsdv_proto_reflection_rs",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    vendor_available: true,
    compile_multilib: "both",
    installable: false,
}
