package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "sdv_telemetry_service_agent_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "main.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry-V1-rust",
        "google.sdv.telemetry.configurable_publisher-V2-rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "liblog_rust",
        "librustutils",
        "libsdv_dump",
        "libsdv_log_rust",
        "libsdv_telemetry",
        "libsdv_telemetry_configurable_publisher",
        "libsdv_telemetry_platform_abstraction_layer",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_service_publisher_accessor",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    vintf_fragment_modules: [
        // keep-sorted start
        "google.sdv.telemetry-service.xml",
        "google.sdv.telemetry.configurable_publisher-service.xml",
        // keep-sorted end
    ],
}

rust_binary {
    name: "sdv_telemetry_service_agent",
    visibility: ["//device/google/sdv"],
    defaults: ["sdv_telemetry_service_agent_defaults"],
    features: [
        "comms_stack",
        "platform_abstraction_layer_core",
    ],
    required: ["com.google.sdv.telemetry"],
    system_ext_specific: true,
    rustlibs: [
        // keep-sorted start
        "libfutures",
        "libsdv_comms_rs",
        "libsdv_telemetry_comms_stack_wrapper",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_platform_abstraction_layer_core",
        // keep-sorted end
    ],
}

rust_binary {
    name: "sdv_ivi_telemetry_service_agent",
    visibility: ["//device/google/sdv"],
    defaults: ["sdv_telemetry_service_agent_defaults"],
    features: [
        "platform_abstraction_layer_ivi",
    ],
    rustlibs: [
        // keep-sorted start
        "libsdv_telemetry_platform_abstraction_layer_ivi",
        // keep-sorted end
    ],
    system_ext_specific: true,
    min_sdk_version: "35",
}
