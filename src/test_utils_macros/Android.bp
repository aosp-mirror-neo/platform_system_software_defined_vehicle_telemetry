// Copyright 2024 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_test_utils_macros_defaults",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libproc_macro2",
        "libquote",
        "libsyn",
        // keep-sorted end
    ],
}

rust_proc_macro {
    name: "libsdv_telemetry_test_utils_macros",
    defaults: ["libsdv_telemetry_test_utils_macros_defaults"],
    crate_name: "sdv_telemetry_test_utils_macros",
    visibility: [
        // Do not add additional modules here. Use `libsdv_telemetry_test_utils`
        // instead, which re-exports the macros from
        // `libsdv_telemetry_test_utils_macros`.
        "//system/software_defined_vehicle/telemetry/src/test_utils:__subpackages__",
    ],
}

rust_test_host {
    name: "sdv_mt_telemetry_unit_test_utils_macros_test",
    host_cross_supported: false,
    defaults: ["libsdv_telemetry_test_utils_macros_defaults"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        "sdv-host-unit-tests",
        // keep-sorted end
    ],
    test_options: {
        unit_test: true,
    },
    auto_gen_config: true,
}
