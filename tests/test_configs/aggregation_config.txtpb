# proto-file: proto/metrics_configuration.proto
# proto-message: MetricsConfig

uuid: "94619dc5-b19b-436c-89d7-b7b9d7619275"
version: 01
descriptor_protos {
  name: "metrics.proto"
  package: "android.automotive.telemetry.messages"
  message_type {
    name: "Report"
    field { label: LABEL_REPEATED type: TYPE_INT32 name: "int_vector" number: 1 }
  }
}

sources {
  name: "dt_source"
  data_source { source_identifier: "<placeholder>" }
}

sources {
  name: "agg_source"
  aggregator {
    trigger_names: "data_trigger"
    message_builder {
      message_type: ".android.automotive.telemetry.messages.Report"
      field_assignments {
        field_name: "int_vector"
        vector_aggregation { expression_node_index: 0 max_length: 100 }
      }
    }
  }
}

expression_nodes { field_leaf_node { source_name: "dt_source" field_names: "int_field" } }

expression_nodes { field_leaf_node { source_name: "agg_source" field_names: "int_vector" } }

triggers {
  name: "deactivate_trigger"
  periodic_trigger { interval { seconds: 6 } }
}

triggers {
  name: "report_trigger"
  periodic_trigger { interval { seconds: 4 } }
}

triggers {
  name: "data_trigger"
  data_trigger { source_name: "dt_source" }
}

deactivate_trigger_name: "deactivate_trigger"

metrics_report_configs {
  name: "Report"
  trigger_names: "report_trigger"
  message_builder {
    message_type: ".android.automotive.telemetry.messages.Report"
    field_assignments {
      field_name: "int_vector"
      no_aggregation { expression_node_index: 1 }
    }
  }
}
