<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright 2024 Google LLC. -->
<!-- This test config is based on the auto-generated test config - the only
     change is the addition of the `test-threads=1` flag. -->
<configuration description="Config to run {MODULE} device tests.">
    {EXTRA_CONFIGS}

    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
        <option name="cleanup" value="true" />
        <option name="push" value="{MODULE}->/data/local/tmp/{MODULE}" />
    </target_preparer>

    <!-- TODO(b/395637397): Update tests to work with authz enabled -->
    <target_preparer class="com.android.tradefed.targetprep.DeviceSetup">
        <!-- Needed to prevent DeviceSetup from trying to set device features,
             unsupported on minimal SDV device. -->
        <option name="force-skip-settings" value="true" />
        <!-- Ensure authz is disabled -->
        <option name="set-property" key="sdv.authz.enable" value="false" />
        <!-- Restore default authz setting on teardown -->
        <option name="restore-properties" value="true" />
    </target_preparer>

    <test class="com.android.tradefed.testtype.rust.RustBinaryTest" >
        <option name="test-device-path" value="/data/local/tmp" />
        <option name="module-name" value="{MODULE}" />
        <!-- When we run run multiple tests they run in parallel by default.
             This will create issue as the telemetry service does not support
             multiple concurrent clients. Therefore, we serialize the test
             execution using the configuration below.
        -->
        <option name="native-test-flag" value="--test-threads=1" />
    </test>
</configuration>
