# proto-message: MetricsConfig

uuid: "94619dc5-b19b-436c-89d7-b7b9d7619275"
version: 01
descriptor_protos {
  name: "metrics.proto"
  package: "android.automotive.telemetry.messages"
  message_type {
    name: "Report"
    field { label: LABEL_REPEATED type: TYPE_INT32 name: "int_vector" number: 1 }
  }
}

publishers {
  name: "dt_publisher"
  service_publisher { service_name: "<placeholder>" }
}

publishers {
  name: "agg_publisher"
  aggregation_publisher {
    trigger_names: "data_trigger"
    message_builder {
      message_type: ".android.automotive.telemetry.messages.Report"
      field_assignments {
        field_name: "int_vector"
        vector_aggregation { expression_node_index: 0 max_length: 100 }
      }
    }
  }
}

expression_nodes { field_leaf_node { publisher_name: "dt_publisher" field_names: "int_field" } }

expression_nodes { field_leaf_node { publisher_name: "agg_publisher" field_names: "int_vector" } }

triggers {
  name: "finish_trigger"
  periodic_trigger { interval { seconds: 6 } }
}

triggers {
  name: "report_trigger"
  periodic_trigger { interval { seconds: 4 } }
}

triggers {
  name: "data_trigger"
  data_trigger { publisher_name: "dt_publisher" }
}

finish_trigger_name: "finish_trigger"

metrics_report_configs {
  name: "Report"
  trigger_names: "report_trigger"
  message_builder {
    message_type: ".android.automotive.telemetry.messages.Report"
    field_assignments {
      field_name: "int_vector"
      no_aggregation { expression_node_index: 1 }
    }
  }
}
