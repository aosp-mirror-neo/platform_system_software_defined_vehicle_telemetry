// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_binary {
    name: "sdv_telemetry_dt_publisher_for_fetch_last_message_e2e_test",
    defaults: ["sdv_telemetry@rust_defaults"],
    srcs: ["publisher.rs"],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "librand",
        "libsample_publisher_proto",
        "libsdv_comms_rs",
        "libsdv_proto_reflection_rs",
        "libsdv_status_rs",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_dt_publisher_for_fetch_last_message_e2e_test_proto",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    vendor: true,
}

rust_protobuf {
    name: "libsdv_telemetry_dt_publisher_for_fetch_last_message_e2e_test_proto",
    crate_name: "sdv_telemetry_dt_publisher_for_fetch_last_message_e2e_test_proto",
    protos: [
        "publisher.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "publisher_source",
    vendor_available: true,
}
