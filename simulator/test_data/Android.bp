// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

rust_protobuf {
    name: "libsdv_telemetry_simulator_test_proto",
    visibility: ["//system/software_defined_vehicle/telemetry/simulator:__subpackages__"],
    crate_name: "sdv_telemetry_simulator_test_proto",
    protos: [
        "test.proto",
        "test_dep.proto",
    ],
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    source_stem: "sdv_telemetry_simulator_test_proto",
    vendor_available: true,
}

filegroup {
    name: "libsdv_telemetry_simulator_test_data",
    visibility: ["//system/software_defined_vehicle/telemetry/simulator:__subpackages__"],
    srcs: ["*"],
}
