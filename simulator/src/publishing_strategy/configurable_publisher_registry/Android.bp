// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_simulator_publishing_strategy_configurable_publisher_registry_defaults",
    defaults: ["sdv_telemetry_simulator@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V2-rust",
        "libanyhow",
        "libbinder_rs",
        "libparking_lot",
        "libprotobuf",
        "libsdv_telemetry_simulator_publishing_strategy",
        "libsdv_telemetry_utils",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_simulator_publishing_strategy_configurable_publisher_registry",
    visibility: ["//system/software_defined_vehicle/telemetry/simulator:__subpackages__"],
    defaults: ["libsdv_telemetry_simulator_publishing_strategy_configurable_publisher_registry_defaults"],
    crate_name: "sdv_telemetry_simulator_publishing_strategy_configurable_publisher_registry",
}
