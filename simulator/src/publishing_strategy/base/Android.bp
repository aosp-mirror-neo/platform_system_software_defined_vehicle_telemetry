// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "libsdv_telemetry_simulator_publishing_strategy_defaults",
    defaults: ["sdv_telemetry_simulator@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libdowncast_rs",
        "libprotobuf",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_simulator_publishing_strategy",
    visibility: ["//system/software_defined_vehicle/telemetry/simulator:__subpackages__"],
    defaults: ["libsdv_telemetry_simulator_publishing_strategy_defaults"],
    crate_name: "sdv_telemetry_simulator_publishing_strategy",
}
