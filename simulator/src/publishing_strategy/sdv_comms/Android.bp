// Copyright 2025 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "libsdv_telemetry_simulator_publishing_strategy_sdv_comms_defaults",
    defaults: ["sdv_telemetry_simulator@rust_defaults"],
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libprotobuf",
        "librand",
        "libsdv_comms_rs",
        "libsdv_proto_reflection_rs",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_dt_wrapper",
        "libsdv_telemetry_simulator_publishing_strategy",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libasync_trait",
        // keep-sorted end
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_telemetry_simulator_publishing_strategy_sdv_comms",
    defaults: ["libsdv_telemetry_simulator_publishing_strategy_sdv_comms_defaults"],
    crate_name: "sdv_telemetry_simulator_publishing_strategy_sdv_comms",
}

rust_test {
    name: "sdv_mt_telemetry_integration_simulator_publishing_strategy_sdv_comms_test",
    defaults: ["libsdv_telemetry_simulator_publishing_strategy_sdv_comms_defaults"],
    rustlibs: [
        // keep-sorted start
        "libfutures",
        "libgoogletest_rust",
        "libitertools",
        "libmockall",
        "libsdv_telemetry_test_utils",
        // keep-sorted end
    ],
    flags: [
        // keep-sorted start
        "-A clippy::borrowed_box",
        "-A clippy::panic",
        "-A clippy::unwrap_used",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    test_config_template: ":sdv_telemetry_integration_test_config_template",
    test_options: {
        unit_test: false,
    },
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
}
