// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "libsdv_telemetry_simulator_lib_defaults",
    defaults: ["sdv_telemetry_simulator@rust_defaults"],
    crate_name: "sdv_telemetry_simulator_lib",
    srcs: [
        "lib.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libbinder_rs",
        "libchrono",
        "libclap",
        "libcsv",
        "libfutures",
        "liblog_rust",
        "liblogger",
        "libparking_lot",
        "libprotobuf",
        "libscopeguard",
        "libsdv_log_rust",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_simulator_proto",
        "libsdv_telemetry_simulator_publishing_strategy",
        "libsdv_telemetry_utils",
        "libstrum",
        "libthiserror",
        "libtokio",
        "libtokio_stream",
        "libtokio_util",
        // keep-sorted end
    ],
    proc_macros: [
        // keep-sorted start
        "libstrum_macros",
        // keep-sorted end
    ],
    vendor: true,
}

rust_library {
    name: "libsdv_telemetry_simulator_lib",
    defaults: ["libsdv_telemetry_simulator_lib_defaults"],
}

rust_test {
    name: "sdv_mt_telemetry_unit_simulator_test",
    defaults: ["libsdv_telemetry_simulator_lib_defaults"],
    rustlibs: [
        // keep-sorted start
        "libgoogletest_rust",
        "libsdv_telemetry_simulator_test_proto",
        "libsdv_telemetry_test_utils",
        "libtempfile",
        // keep-sorted end
    ],
    data: [
        // keep-sorted start
        ":libsdv_telemetry_simulator_test_data",
        // keep-sorted end
    ],
    flags: [
        // keep-sorted start
        "-A clippy::panic",
        "-A clippy::unwrap_used",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    test_options: {
        unit_test: true,
    },
    auto_gen_config: true,
    // Requires root so the test can create required directories in
    // /data/local/tests/
    require_root: true,
}
