// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "sdv_telemetry_simulator_defaults",
    defaults: ["sdv_telemetry_simulator@rust_defaults"],
    srcs: [
        "main.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libclap",
        "liblog_rust",
        "libsdv_log_rust",
        "libsdv_telemetry_simulator_lib",
        "libsdv_telemetry_simulator_publishing_strategy",
        "libsdv_telemetry_simulator_publishing_strategy_configurable_publisher_registry",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    vendor: true,
}

rust_defaults {
    name: "sdv_telemetry_simulator_with_comms_stack_defaults",
    defaults: ["sdv_telemetry_simulator_defaults"],
    rustlibs: [
        // keep-sorted start
        "libsdv_comms_rs",
        "libsdv_telemetry_comms_utils",
        "libsdv_telemetry_simulator_publishing_strategy_sdv_comms",
        // keep-sorted end
    ],
    features: [
        "comms_stack",
    ],
}

rust_binary {
    name: "sdv_telemetry_simulator",
    visibility: ["//device/google/sdv"],
    defaults: ["sdv_telemetry_simulator_with_comms_stack_defaults"],
}

rust_binary {
    name: "sdv_ivi_telemetry_simulator",
    visibility: ["//device/google/sdv"],
    defaults: ["sdv_telemetry_simulator_defaults"],
}

rust_test {
    name: "sdv_mt_telemetry_integration_simulator_test",
    defaults: ["sdv_telemetry_simulator_with_comms_stack_defaults"],
    test_config_template: ":sdv_telemetry_integration_test_config_template",
    test_options: {
        unit_test: false,
    },
    rustlibs: [
        // keep-sorted start
        "libcsv",
        "libenv_logger",
        "libgoogletest_rust",
        "libprotobuf",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_simulator_proto",
        "libsdv_telemetry_test_utils",
        "libserde",
        "libtempfile",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    flags: [
        // keep-sorted start
        "-A clippy::panic",
        "-A clippy::unwrap_used",
        // keep-sorted end
    ],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    auto_gen_config: true,
    require_root: true,
}
