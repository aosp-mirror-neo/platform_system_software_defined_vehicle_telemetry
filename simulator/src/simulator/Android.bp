// Copyright 2025 Google LLC

package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "sdv_telemetry_simulator_defaults",
    defaults: ["sdv_telemetry_simulator@rust_defaults"],
    srcs: [
        "main.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "liblog_rust",
        "libsdv_log_rust",
        "libsdv_telemetry_simulator_lib",
        "libsdv_telemetry_utils",
        "libtokio",
        // keep-sorted end
    ],
    vendor: true,
}

rust_binary {
    name: "sdv_telemetry_simulator",
    defaults: ["sdv_telemetry_simulator_defaults"],
}

// TODO: b/448368262 - Update SDV_IVI_TELEMETRY_SAMPLES_PACKAGES to use this
// target, as well as all of our e2e tests that run on IVI.
rust_binary {
    name: "sdv_ivi_telemetry_simulator",
    defaults: ["sdv_telemetry_simulator_defaults"],
}
