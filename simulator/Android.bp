package {
    default_team: "trendy_team_connectivity_telemetry",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: ["//visibility:private"],
}

rust_defaults {
    name: "sdv_telemetry_simulator@rust_defaults",
    defaults_visibility: ["//system/software_defined_vehicle/telemetry/simulator:__subpackages__"],
    defaults: ["sdv_telemetry@rust_defaults"],
    flags: [
        // keep-sorted start
        "-D clippy::allow_attributes_without_reason",
        "-D clippy::assertions_on_result_states",
        "-D clippy::branches_sharing_code",
        "-D clippy::cast_lossless",
        "-D clippy::cast_possible_truncation",
        "-D clippy::cast_possible_wrap",
        "-D clippy::cast_precision_loss",
        "-D clippy::cast_sign_loss",
        "-D clippy::clone_on_copy",
        "-D clippy::clone_on_ref_ptr",
        "-D clippy::cloned_instead_of_copied",
        "-D clippy::collection_is_never_read",
        "-D clippy::equatable_if_let",
        "-D clippy::explicit_into_iter_loop",
        "-D clippy::explicit_iter_loop",
        "-D clippy::filetype_is_file",
        "-D clippy::indexing_slicing",
        "-D clippy::match_bool",
        "-D clippy::panic",
        "-D clippy::single_match_else",
        "-D clippy::unwrap_used",
        // keep-sorted end
    ],
}
