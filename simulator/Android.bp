// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "telemetry_simulator@rust_defaults",
    defaults: [
        "sdv_telemetry@rust_defaults",
    ],
    srcs: [
        "src/simulator.rs",
    ],
    rustlibs: [
        // keep-sorted start
        "google.sdv.telemetry.configurable_publisher-V1-rust",
        "libanyhow",
        "libbinder_rs",
        "libchrono",
        "libclap",
        "libcsv",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libsdv_log_rust",
        "libsdv_telemetry_proto_rust",
        "libsdv_telemetry_proto_simulation_publisher",
        "libsdv_telemetry_rust_wrapper",
        "libsdv_telemetry_sample_utils",
        "libsdv_telemetry_utils",
        "libthiserror",
        "libtokio",
        // keep-sorted end
    ],
    flags: [
        // keep-sorted start
        "-D clippy::allow_attributes_without_reason",
        "-D clippy::as_conversions",
        "-D clippy::assertions_on_result_states",
        "-D clippy::branches_sharing_code",
        "-D clippy::cast_lossless",
        "-D clippy::clone_on_copy",
        "-D clippy::clone_on_ref_ptr",
        "-D clippy::cloned_instead_of_copied",
        "-D clippy::collection_is_never_read",
        "-D clippy::equatable_if_let",
        "-D clippy::explicit_into_iter_loop",
        "-D clippy::explicit_iter_loop",
        "-D clippy::filetype_is_file",
        "-D clippy::match_bool",
        "-D clippy::panic",
        "-D clippy::single_match_else",
        "-D clippy::unwrap_used",
        // keep-sorted end
    ],
    vendor: true,
}

rust_binary {
    name: "sdv_telemetry_simulator",
    defaults: ["telemetry_simulator@rust_defaults"],
}

rust_protobuf {
    name: "libsdv_telemetry_proto_simulation_publisher",
    crate_name: "sdv_telemetry_proto_simulation_publisher",
    proto_flags: [
        "-I external/protobuf/src",
        "-I .",
    ],
    protos: ["src/simulation_publisher.proto"],
    source_stem: "sdv_telemetry_proto_simulation_publisher_source",
    vendor_available: true,
}
